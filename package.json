  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "tailwind": "npx tailwindcss -i ./src/input.css -o ./public/css/style.css --watch",
    "firebase": "firebase serve",
    "dev": "npm-run-all --parallel tailwind firebase",
    "translate:zh": "node tools/translate_to_chinese.mjs",
    "translate:zh:batch": "bash tools/batch_translate.sh",
    "translate:zh:test": "node tools/translate_to_chinese.mjs public/es_en_01.json tools/sample_zh_en_01.json",
    "translate:ko": "node tools/translate_to_korean.mjs",
    "translate:ko:batch": "bash tools/batch_translate_korean.sh",
    "translate:ko:test": "node tools/translate_to_korean.mjs public/es_en_01.json tools/sample_ko_en_01.json",
    "translate:ja": "node tools/translate_to_japanese.mjs",
    "translate:ja:batch": "bash tools/batch_translate_japanese.sh",
    "translate:ja:test": "node tools/translate_to_japanese.mjs public/es_en_01.json tools/sample_ja_en_01.json",
    "audio:generate": "node tools/generate_audio_azure.mjs",
    "audio:batch": "bash tools/batch_generate_audio.sh",
    "validate:phrases": "node tools/validate_phrases.mjs",
    "fix:phrases": "node tools/apply_phrase_fixes.mjs",
    "update:translations": "node tools/update_translations.mjs",
    "audio:regenerate": "node tools/regenerate_audio.mjs"
  },
