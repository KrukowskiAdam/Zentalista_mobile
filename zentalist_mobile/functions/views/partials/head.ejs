<head>
  <!-- Instant auth state restore to prevent flash -->
  <script>
    (function () {
      try {
        var authState = localStorage.getItem('mc_auth_state');
        var avatarCache = localStorage.getItem('mc_menu_avatar');
        // Add CSS to document to hide/show auth elements before DOM loads
        var style = document.createElement('style');
        if (authState === 'logged-in') {
          style.textContent = '.auth-logged-out{display:none!important}.auth-logged-in{display:flex!important;opacity:1!important}';
        } else if (authState === 'logged-out') {
          style.textContent = '.auth-logged-in{display:none!important}.auth-logged-out{display:flex!important;opacity:1!important}';
        }
        if (avatarCache) {
          var avatar = JSON.parse(avatarCache);
          if (avatar.avatarUrl) {
            style.textContent += '#menu-avatar-icon{display:none!important}#menu-avatar-img{display:block!important}';
          }
        }
        document.head.appendChild(style);
        // Store for later use
        window.__authStateCache = authState;
        window.__avatarCache = avatarCache ? JSON.parse(avatarCache) : null;
        // Add auth-ready class to html immediately if we have cached state
        if (authState) {
          document.documentElement.classList.add('auth-ready');
        }
      } catch (e) { }
    })();
  </script>
  <script>
    (function () {
      try {
        var ua = (navigator.userAgent || '').toLowerCase();
        var hasCapacitorUA = ua.indexOf('capacitor') !== -1;
        var hasNativeBridge = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
        var isNative = hasCapacitorUA || hasNativeBridge;

        window.__MOBILE_APP__ = isNative;
        window.__MOBILE_PLATFORM__ = window.Capacitor && window.Capacitor.getPlatform
          ? window.Capacitor.getPlatform()
          : (isNative ? 'unknown' : 'web');
      } catch (error) {
        window.__MOBILE_APP__ = false;
        window.__MOBILE_PLATFORM__ = 'web';
      }
    })();
  </script>
