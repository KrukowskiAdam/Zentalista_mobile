<!-- Modal rejestracji -->
<input type="checkbox" id="modal-signup" class="modal-toggle" />
<div class="modal modal-bottom sm:modal-middle">
 <div class="modal-box bg-base-200 text-base-content">
 <h3 class="font-bold text-lg">Sign Up</h3>
 <form id="signup-form" class="space-y-4 mt-4">
 <input type="email" id="signup-email" placeholder="Email" autocomplete="username"
 class="input input-bordered w-full" required />
 <input type="password" id="signup-password" placeholder="Password" autocomplete="new-password"
 class="input input-bordered w-full" required />
 <div class="modal-action">
 <label for="modal-signup" class="btn btn">Cancel</label>
 <button type="submit" class="btn btn-primary">Sign Up</button>
 </div>
 </form>
 </div>
</div>

<!-- Modal logowania -->
<input type="checkbox" id="modal-login" class="modal-toggle" />
<div class="modal modal-bottom sm:modal-middle">
 <div class="modal-box bg-base-200 text-base-content">
 <h3 class="font-bold text-lg">Log In</h3>
 <form id="login-form" class="space-y-4 mt-4">
 <input type="email" id="login-email" name="email" placeholder="Email" autocomplete="username"
 class="input input-bordered w-full" required />
 <input type="password" id="login-password" name="current-password" placeholder="Password"
 autocomplete="current-password" class="input input-bordered w-full" required />

 <input type="hidden" name="username" autocomplete="username" />
 <input type="hidden" name="password" autocomplete="current-password" />

 <div class="modal-action">
 <label for="modal-login" class="btn btn">Cancel</label>
 <button type="submit" class="btn btn-primary">Log In</button>
 </div>
 </form>
 </div>
</div>

<!-- Modal resetowania hasła -->
<input type="checkbox" id="modal-forgot-password" class="modal-toggle" />
<div class="modal modal-bottom sm:modal-middle">
 <div class="modal-box bg-base-200 text-base-content">
 <h3 class="font-bold text-lg">Reset Password</h3>
 <form id="forgot-password-form" class="space-y-4 mt-4">
 <input type="email" id="forgot-password-email" placeholder="Email" autocomplete="email"
 class="input input-bordered w-full" required />
 <div class="modal-action">
 <label for="modal-forgot-password" class="btn btn">Cancel</label>
 <button type="submit" class="btn btn-primary">Reset</button>
 </div>
 </form>
 </div>
</div>