        {
            "name": "Family - Phrases",
            "words": [
                {
                    "ko": "여기에 가족이 있나요?",
                    "romaja": "Yeogie gajogi innayo?",
                    "en": "Do you have family here?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0025.mp3"
                },
                {
                    "ko": "가족이 몇 명이에요?",
                    "romaja": "Gajogi myeot myeongieyo?",
                    "en": "How many in your family?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0026.mp3"
                },
                {
                    "ko": "형제자매가 있나요?",
                    "romaja": "Hyeongjejamaega innayo?",
                    "en": "Do you have siblings?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0027.mp3"
                },
                {
                    "ko": "남자 형제가 한 명 있어요",
                    "romaja": "Namja hyeongjega han myeong isseoyo",
                    "en": "I have one brother",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0028.mp3"
                },
                {
                    "ko": "자녀가 있나요?",
                    "romaja": "Janyeoga innayo?",
                    "en": "Do you have children?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0029.mp3"
                },
                {
                    "ko": "아이가 두 명 있어요",
                    "romaja": "Aiga du myeong isseoyo",
                    "en": "I have two kids",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0030.mp3"
                },
                {
                    "ko": "결혼하셨나요?",
                    "romaja": "Gyeolhonhasyeonnayo?",
                    "en": "Are you married?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0031.mp3"
                },
                {
                    "ko": "미혼입니다",
                    "romaja": "Mihonimnida",
                    "en": "I'm single",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0032.mp3"
                },
                {
                    "ko": "우리 가족이에요",
                    "romaja": "Uri gajogieyo",
                    "en": "This is my family",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0033.mp3"
                },
                {
                    "ko": "아버지는 일하세요",
                    "romaja": "Abeojineun ilhaseyo",
                    "en": "My father works",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0034.mp3"
                },
                {
                    "ko": "어머니는 집에 계세요",
                    "romaja": "Eomeonineun jibe gyeseyo",
                    "en": "My mother is at home",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0035.mp3"
                },
                {
                    "ko": "연세가 어떻게 되세요?",
                    "romaja": "Yeonsega eotteoke doeseyo?",
                    "en": "How old are they?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0036.mp3"
                },
                {
                    "ko": "멀리 사세요",
                    "romaja": "Meolli saseyo",
                    "en": "They live far away",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0037.mp3"
                },
                {
                    "ko": "가족이 보고 싶어요",
                    "romaja": "Gajogi bogo sipeoyo",
                    "en": "I miss my family",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0038.mp3"
                },
                {
                    "ko": "가족은 소중해요",
                    "romaja": "Gajogeun sojunghaeyo",
                    "en": "Family is important",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0039.mp3"
                },
                {
                    "ko": "저는 가족을 사랑해요",
                    "romaja": "Jeoneun gajogeul saranghaeyo",
                    "en": "I love my family",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0040.mp3"
                },
                {
                    "ko": "가족을 방문합시다",
                    "romaja": "Gajogeul bangmunhapsida",
                    "en": "Let's visit family",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0041.mp3"
                },
                {
                    "ko": "오늘 밤은 가족 저녁 식사가 있어요",
                    "romaja": "Oneul bameun gajok jeonyeok siksaga isseoyo",
                    "en": "Family dinner tonight",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0042.mp3"
                },
                {
                    "ko": "지금은 부모님과 함께 살아요",
                    "romaja": "Jigeumeun bumonimgwa hamkke sarayo",
                    "en": "We live with my parents for now",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0043.mp3"
                },
                {
                    "ko": "제가 집안의 맏이예요",
                    "romaja": "Jega jibanui majiyeyo",
                    "en": "I'm the oldest child in the family",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0044.mp3"
                },
                {
                    "ko": "우리는 돌아가며 육아를 도와요",
                    "romaja": "Urineun doragamyeo yugareul dowayo",
                    "en": "We take turns helping with childcare",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0045.mp3"
                },
                {
                    "ko": "제 여동생에게 전화해서 초대해 주시겠어요?",
                    "romaja": "Je yeodongsaengege jeonhwahaeseo chodaehae jusigesseoyo?",
                    "en": "Could you call my sister and invite her?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0046.mp3"
                },
                {
                    "ko": "조부모님과 영상 통화를 계획해 봐요",
                    "romaja": "Jobumonimgwa yeongsang tonghwareul gyehoekhae bwayo",
                    "en": "Let's plan a video call with the grandparents",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/ko/06/ko_0047.mp3"
                }
            ]
        },
