<!DOCTYPE html>
<html lang="en" style="background-color: #030712;">
<%- include('partials/head') %>

  <body class="m-0 p-0 bg-dark-bg text-gray-200" style="padding-top: 80px;">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5L47BNJP" height="0" width="0"
        style="display: none; visibility: hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <%- include('partials/menu') %>

      <style>
        @media (max-width: 640px) {
          #leaderboard-content .leaderboard-table {
            display: block;
          }

          #leaderboard-content .leaderboard-table thead {
            display: none;
          }

          #leaderboard-content .leaderboard-table tbody {
            display: block;
          }

          #leaderboard-content .leaderboard-table tbody tr {
            display: grid;
            grid-template-columns: auto 1fr auto;
            grid-template-rows: auto auto;
            border: 1px solid #1f2937;
            border-radius: 0.75rem;
            padding: 0.75rem;
            margin-bottom: 0.75rem;
            background-color: #0f172a;
            gap: 0.5rem;
          }

          #leaderboard-content .leaderboard-table tbody tr:last-child {
            margin-bottom: 0;
          }

          #leaderboard-content .leaderboard-table tbody th,
          #leaderboard-content .leaderboard-table tbody td {
            display: block;
            width: 100%;
            padding: 0;
            text-align: left;
            white-space: normal;
          }

          #leaderboard-content .leaderboard-table tbody tr>*:nth-child(1) {
            grid-column: 1;
            grid-row: 1;
          }

          #leaderboard-content .leaderboard-table tbody tr>*:nth-child(2) {
            grid-column: 2;
            grid-row: 1;
          }

          #leaderboard-content .leaderboard-table tbody tr>*:nth-child(3) {
            grid-column: 3;
            grid-row: 1;
            justify-self: end;
            text-align: right;
          }

          #leaderboard-content .leaderboard-table tbody tr>*:nth-child(4) {
            grid-column: 1;
            grid-row: 2;
          }

          #leaderboard-content .leaderboard-table tbody tr>*:nth-child(5) {
            grid-column: 2;
            grid-row: 2;
          }

          #leaderboard-content .leaderboard-table tbody tr>*:nth-child(6) {
            grid-column: 3;
            grid-row: 2;
            justify-self: end;
            text-align: right;
          }

          #leaderboard-content .leaderboard-table tbody [data-label]::before {
            content: attr(data-label);
            display: block;
            font-size: 0.65rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: #9ca3af;
            margin-bottom: 0.15rem;
          }

        }
      </style>

