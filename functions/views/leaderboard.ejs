          <script defer type="module" src="/scripts/auth.js"></script>
          <script defer type="module" src="/scripts/index.js"></script>
          <script type="module">
            import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
            import {
              getAuth,
              onAuthStateChanged,
            } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
            import {
              getFirestore,
              collection,
              getDocs,
              query,
              orderBy,
              limit,
              doc,
              setDoc,
              getDoc,
            } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

            // Firebase config
            const firebaseConfig = {
              apiKey: "AIzaSyA5TmUWOFkanWSVj-GU3SgDiKyD86yDgoQ",
              authDomain: "costam-3f612.firebaseapp.com",
              databaseURL: "https://costam-3f612-default-rtdb.firebaseio.com",
              projectId: "costam-3f612",
              storageBucket: "costam-3f612.firebasestorage.app",
              messagingSenderId: "767407380440",
              appId: "1:767407380440:web:eb4a082d596a7a69c384ad",
            };

            const app = initializeApp(firebaseConfig);
            const auth = getAuth(app);
            const db = getFirestore(app);

            let currentUser = null;
            let currentPage = 1;
            const ITEMS_PER_PAGE = 50;

            // Points configuration
            const POINTS = {
              CATEGORY_COMPLETION: 5,  // 5 points per category completion (star)
              CATEGORY_CHALLENGE_PASS: 10,
              CATEGORY_CHALLENGE_PERFECT: 20,
              POINTS_PER_LEVEL: 100,
            };

            // Language configuration with flags
            const LANGUAGES = {
              es: { name: "Spanish", flag: "🇪🇸" },
              de: { name: "German", flag: "🇩🇪" },
              fr: { name: "French", flag: "🇫🇷" },
              ru: { name: "Russian", flag: "🇷🇺" },
              zh: { name: "Chinese", flag: "🇨🇳" },
              ja: { name: "Japanese", flag: "🇯🇵" },
              ko: { name: "Korean", flag: "🇰🇷" },
              it: { name: "Italian", flag: "🇮🇹" },
            };

            /**
             * Calculate user statistics from localStorage
             * CRITICAL: Verify data belongs to current user before using
             */
            function calculateUserStats() {
              const stats = {
                totalPoints: 0,
                starPoints: 0,
                challengePoints: 0,
                wordsCompleted: 0,
                starsEarned: 0,
                challengesCompleted: 0,
                languageBreakdown: {},
              };

              // CRITICAL: Verify localStorage data belongs to current user
              const storedUserId = localStorage.getItem("mc_current_user_id");
              if (!currentUser || storedUserId !== currentUser.uid) {
                console.warn("⚠️ localStorage data doesn't belong to current user, returning empty stats");
                stats.level = 1;
                stats.levelProgress = "0.0";
                return stats;
              }

              Object.keys(LANGUAGES).forEach((lang) => {
                const buttonStates = JSON.parse(
                  localStorage.getItem(`buttonStates_${lang}`) || "{}"
                );
                const repeatCounts = JSON.parse(
                  localStorage.getItem(`repeatCounts_${lang}`) || "{}"
                );
                const completionMap = JSON.parse(
                  localStorage.getItem(`categoryCompletionDates_${lang}`) || "{}"
                );

                // Count completed words (for display, not points)
                let langWordsCompleted = 0;
                Object.values(buttonStates).forEach((state) => {
                  if (state.locked) {
                    langWordsCompleted++;
                  }
                });

                // Count stars (category completions) - 5 points each
                const langStars = Object.values(repeatCounts).reduce(
                  (sum, count) => sum + (count || 0), 0
                );
                const langStarPoints = langStars * POINTS.CATEGORY_COMPLETION;

                // Count challenge bonus points
                const completionEntries = Object.values(completionMap).filter(
                  (entry) => entry && typeof entry === "object" && "totalBonusPoints" in entry
                );
                const langChallengesCompleted = completionEntries.length;
                const langChallengePoints = completionEntries.reduce(
                  (sum, entry) => sum + (entry.totalBonusPoints || entry.bonusPoints || 0),
                  0
                );

                const langTotalPoints = langStarPoints + langChallengePoints;

                stats.wordsCompleted += langWordsCompleted;
                stats.starsEarned += langStars;
                stats.challengesCompleted += langChallengesCompleted;
                stats.starPoints += langStarPoints;
                stats.challengePoints += langChallengePoints;
                stats.languageBreakdown[lang] = {
                  words: langWordsCompleted,
                  stars: langStars,
                  challenges: langChallengesCompleted,
                  points: langTotalPoints,
                };
              });

              stats.totalPoints = stats.starPoints + stats.challengePoints;
              stats.level =
                Math.floor(stats.totalPoints / POINTS.POINTS_PER_LEVEL) + 1;
              stats.levelProgress = (
                ((stats.totalPoints % POINTS.POINTS_PER_LEVEL) /
                  POINTS.POINTS_PER_LEVEL) *
                100
              ).toFixed(1);

              return stats;
            }

            /**
             * Sync user stats to Firestore
             */
            async function syncStatsToFirestore(userId, stats) {
              try {
                const userRef = doc(db, "leaderboard", userId);
                await setDoc(
                  userRef,
                  {
                    userId: userId,
                    displayName:
                      currentUser.displayName ||
                      currentUser.email?.split("@")[0] ||
                      "Anonymous",
                    email: currentUser.email,
                    totalPoints: stats.totalPoints,
                    level: stats.level,
                    wordsCompleted: stats.wordsCompleted,
                    starsEarned: stats.starsEarned || 0,
                    challengesCompleted: stats.challengesCompleted || 0,
                    starPoints: stats.starPoints || 0,
                    challengePoints: stats.challengePoints || 0,
                    languageBreakdown: stats.languageBreakdown || {},
                    lastUpdated: new Date().toISOString(),
                  },
                  { merge: true }
                );
                console.log("✅ Stats synced to Firestore");
              } catch (error) {
                console.error("❌ Error syncing stats:", error);
              }
            }

            /**
             * Load and display global leaderboard
             */
            async function loadLeaderboard() {
              const loadingEl = document.getElementById("loading-state");
              const contentEl = document.getElementById("leaderboard-content");
              const emptyEl = document.getElementById("empty-state");
              const errorEl = document.getElementById("error-state");

              loadingEl.classList.remove("hidden");
              contentEl.classList.add("hidden");
              emptyEl.classList.add("hidden");
              errorEl.classList.add("hidden");

              try {
                const leaderboardRef = collection(db, "leaderboard");
                const q = query(
                  leaderboardRef,
                  orderBy("totalPoints", "desc"),
                  limit(100)
                );
                const snapshot = await getDocs(q);

                if (snapshot.empty) {
                  loadingEl.classList.add("hidden");
                  emptyEl.classList.remove("hidden");
                  return;
                }

                const leaderboardData = [];
                snapshot.forEach((doc) => {
                  leaderboardData.push({ id: doc.id, ...doc.data() });
                });

                displayLeaderboard(leaderboardData);

                loadingEl.classList.add("hidden");
                contentEl.classList.remove("hidden");
              } catch (error) {
                console.error("❌ Error loading leaderboard:", error);
                loadingEl.classList.add("hidden");
                errorEl.classList.remove("hidden");
              }
            }

            /**
             * Display leaderboard table
             */
            function displayLeaderboard(data) {
              const tbody = document.getElementById("leaderboard-table-body");
              tbody.innerHTML = "";

              const start = (currentPage - 1) * ITEMS_PER_PAGE;
              const end = start + ITEMS_PER_PAGE;
              const pageData = data.slice(start, end);

              pageData.forEach((user, index) => {
                const globalRank = start + index + 1;
                const row = document.createElement("tr");

                // Dark mode styling - border and hover effect
                row.className = "border-b border-dark-border hover:bg-dark-bg";

                // Highlight current user with blue background
                if (currentUser && user.userId === currentUser.uid) {
                  row.className = "border-b border-blue-600 bg-blue-900/30 hover:bg-blue-900/40";
                }

                // Medal SVG for top 3
                const medalSvg = (color) => `<svg class="w-6 h-6 inline" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2" stroke-linejoin="round"><path d="M15.9201 12.8959L19.2583 8.89003C19.533 8.5604 19.6704 8.39557 19.7681 8.21065C19.8548 8.0466 19.9183 7.87128 19.9567 7.68973C20 7.48508 20 7.27053 20 6.84144V6.2C20 5.07989 20 4.51984 19.782 4.09202C19.5903 3.71569 19.2843 3.40973 18.908 3.21799C18.4802 3 17.9201 3 16.8 3H7.2C6.0799 3 5.51984 3 5.09202 3.21799C4.71569 3.40973 4.40973 3.71569 4.21799 4.09202C4 4.51984 4 5.07989 4 6.2V6.84144C4 7.27053 4 7.48508 4.04328 7.68973C4.08168 7.87128 4.14515 8.0466 4.23188 8.21065C4.32964 8.39557 4.467 8.5604 4.74169 8.89003L8.07995 12.8959M13.4009 11.1989L19.3668 3.53988M10.5991 11.1989L4.6394 3.53414M6.55673 6H17.4505M17 16C17 18.7614 14.7614 21 12 21C9.23858 21 7 18.7614 7 16C7 13.2386 9.23858 11 12 11C14.7614 11 17 13.2386 17 16Z"/></svg>`;

                let rankDisplay = globalRank;
                if (globalRank === 1) rankDisplay = medalSvg('#FFD700'); // Gold
                else if (globalRank === 2) rankDisplay = medalSvg('#C0C0C0'); // Silver
                else if (globalRank === 3) rankDisplay = medalSvg('#CD7F32'); // Bronze

                row.innerHTML = `
            <td class="px-4 py-3 text-center" data-label="Rank">
              <span class="font-bold text-lg text-gray-200">${rankDisplay}</span>
            </td>
            <th scope="row" class="px-4 py-3 font-medium text-gray-200 whitespace-nowrap" data-label="Player">
              <div class="mobile-player-stack flex items-center gap-3">
                <div class="flex items-center justify-center w-10 h-10 rounded-full bg-dark-bg border border-dark-border overflow-hidden">
                  ${user.avatarUrl
                    ? `<img src="${user.avatarUrl}" alt="Avatar" class="w-full h-full object-cover">`
                    : `<span class="text-lg font-semibold text-gray-300">${user.displayName?.[0]?.toUpperCase() || "?"}</span>`
                  }
                </div>
                <div>
                  <div class="font-semibold text-gray-200">${user.displayName || "Anonymous"}</div>
                </div>
              </div>
            </th>
            <td class="px-4 py-3 text-center" data-label="Level">
              ${(() => {
                    const level = user.level || 1;
                    if (level === 1) {
                      // New - Gray
                      return `<span class="px-3 py-1 text-xs font-medium rounded" style="background-color: #E2E8F0; color: #64748B;">Lvl 1</span>`;
                    } else if (level === 2) {
                      // Learning - Blue
                      return `<span class="px-3 py-1 text-xs font-medium text-white rounded" style="background-color: #05C7F2;">Lvl 2</span>`;
                    } else if (level === 3) {
                      // Mastered - Green
                      return `<span class="px-3 py-1 text-xs font-medium text-white rounded" style="background-color: #04BF33;">Lvl 3</span>`;
                    } else if (level === 4) {
                      // Expert - Orange
                      return `<span class="px-3 py-1 text-xs font-medium text-white rounded" style="background-color: #FF8C02;">Lvl 4</span>`;
                    } else {
                      // Expert+ - Orange with level number
                      return `<span class="px-3 py-1 text-xs font-medium text-white rounded" style="background-color: #FF8C02;">Lvl ${level}</span>`;
                    }
                  })()}
            </td>
            <td class="px-4 py-3 text-center" data-label="Stars">
              <span class="text-gray-300 font-medium">${user.starsEarned || 0}</span>
            </td>
            <td class="px-4 py-3 text-center" data-label="Challenges">
              <span class="text-gray-300 font-medium">${user.challengesCompleted || 0}</span>
            </td>
            <td class="px-4 py-3 text-center" data-label="Points">
              <span class="font-bold text-lg text-gray-200">${(
                    user.totalPoints || 0
                  ).toLocaleString()}</span>
            </td>
          `;
                tbody.appendChild(row);
              });

              // Update pagination
              document.getElementById("current-page").textContent = currentPage;
              document.getElementById("prev-page").disabled = currentPage === 1;
              document.getElementById("next-page").disabled = end >= data.length;
            }

            /**
             * Initialize page
             */
            async function init() {
              // Auth state listener
              onAuthStateChanged(auth, async (user) => {
                currentUser = user;

                if (user) {
                  // Calculate user stats
                  const stats = calculateUserStats();

                  // Sync to Firestore
                  await syncStatsToFirestore(user.uid, stats);
                }

                // Load leaderboard
                await loadLeaderboard();
              });

              // Event listeners
              document
                .getElementById("refresh-leaderboard")
                ?.addEventListener("click", loadLeaderboard);
              document.getElementById("prev-page")?.addEventListener("click", () => {
                if (currentPage > 1) {
                  currentPage--;
                  loadLeaderboard();
                }
              });
              document.getElementById("next-page")?.addEventListener("click", () => {
                currentPage++;
                loadLeaderboard();
              });

              // Tab switching
              document.querySelectorAll(".tab").forEach((tab) => {
                tab.addEventListener("click", (e) => {
                  document
                    .querySelectorAll(".tab")
                    .forEach((t) => t.classList.remove("tab-active"));
                  e.target.classList.add("tab-active");

                  const tabType = e.target.dataset.tab;
                  document.getElementById("leaderboard-title").textContent =
                    tabType === "global"
                      ? "Global Rankings"
                      : tabType === "friends"
                        ? "Friends Rankings"
                        : "Country Rankings";

                  // TODO: Implement friends and country filtering
                  loadLeaderboard();
                });
              });
            }

            init();
          </script>
  </body>

</html>