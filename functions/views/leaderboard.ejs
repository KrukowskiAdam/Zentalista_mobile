<!DOCTYPE html>
<html lang="en" class="bg-learning-app-design-2">
<%- include('partials/head') %>

 <body class="m-0 p-0 bg-learning-app-design-2" style="padding-top: calc(80px + constant(safe-area-inset-top)); padding-top: calc(80px + env(safe-area-inset-top, 0px));">
 <!-- Google Tag Manager (noscript) -->
 <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5L47BNJP" height="0" width="0"
 style="display: none; visibility: hidden"></iframe></noscript>
 <!-- End Google Tag Manager (noscript) -->

 <%- include('partials/menu') %>

 <style>
 @media (max-width: 640px) {
 #leaderboard-content .leaderboard-table {
 display: block;
 }

 #leaderboard-content .leaderboard-table thead {
 display: none;
 }

 #leaderboard-content .leaderboard-table tbody {
 display: block;
 }

 #leaderboard-content .leaderboard-table tbody tr {
 display: grid;
 grid-template-columns: auto 1fr auto;
 grid-template-rows: auto;
 border: 1px solid var(--learning-app-design-3);
 border-radius: 0.75rem;
 padding: 0.75rem;
 margin-bottom: 0.75rem;
 gap: 0.5rem;
 align-items: start;
 width: 100%;
 padding: 0;
 text-align: left;
 white-space: normal;
 }

 #leaderboard-content .leaderboard-table tbody tr>*:nth-child(1) {
 grid-column: 1;
 grid-row: 1;
 }

 #leaderboard-content .leaderboard-table tbody tr>*:nth-child(2) {
 grid-column: 2;
 grid-row: 1;
 }

 #leaderboard-content .leaderboard-table tbody tr>*:nth-child(3) {
 grid-column: 3;
 grid-row: 1;
 justify-self: end;
 text-align: right;
 }

 #leaderboard-content .leaderboard-table tbody [data-label]::before {
 content: attr(data-label);
 display: block;
 font-size: 0.65rem;
 letter-spacing: 0.05em;
 text-transform: uppercase;
 color: var(--app-font-color);
 margin-bottom: 0.15rem;
 }

 }
 </style>

 <div class="container mx-auto px-4 pt-4 max-w-6xl">
 <!-- Header card -->
 <div class="rounded-xl bg-learning-app-design-1 p-4 shadow-card mb-4">
 <p class="text-xl font-semibold mb-1">Global Leaderboard</p>
 <p class="text-sm opacity-70 mb-3">Compete with learners worldwide and climb the ranks</p>
 <div id="header-user-row" class="hidden flex items-center gap-3">
 <img id="header-user-avatar" src="" alt="avatar" class="w-10 h-10 rounded-full object-cover flex-shrink-0">
 <div class="min-w-0 flex-1">
 <h1 id="header-user-name" class="text-lg font-bold leading-tight"></h1>
 </div>
 <div class="flex-shrink-0 flex items-center gap-2">
 <p class="text-l leading-tight">Your rank</p>
 <p id="header-user-rank" class="text-l leading-tight"></p>
 </div>
 </div>
 </div>

 <!-- Leaderboard Table -->
 <div class="bg-learning-app-design-1 shadow-card rounded-xl overflow-hidden">
 <!-- Content Area -->
 <div class="p-4">

 <!-- Loading State -->
 <div id="loading-state" class="text-center py-12">
 <span class="loading loading-spinner loading-lg"></span>
 <p class="mt-4">Loading rankings...</p>
 </div>

 <!-- Leaderboard Content -->
 <div id="leaderboard-content" class="hidden">
 <div class="overflow-x-auto overflow-y-visible py-2">
 <table class="leaderboard-table w-full text-sm text-left">
 <thead class="text-xs uppercase bg-learning-app-design-1">
 <tr>
 <th scope="col" class="px-4 py-3 text-center" style="width: 80px">
 Rank
 </th>
 <th scope="col" class="px-4 py-3" style="width: 250px">
 Player
 </th>
 <th scope="col" class="px-4 py-3 text-center" style="width: 140px">
 Points
 </th>
 </tr>
 </thead>
 <tbody id="leaderboard-table-body">
 <!-- Filled by JS -->
 </tbody>
 </table>
 </div>

 <!-- Pagination removed - all users shown with scroll -->
 </div>

 <!-- Empty State -->
 <div id="empty-state" class="hidden text-center py-12">
 <div class="text-6xl mb-4">📊</div>
 <h3 class="text-xl font-bold mb-2">No rankings yet</h3>
 <p class="">
 Be the first to complete some words and climb the leaderboard!
 </p>
 </div>

 <!-- Error State -->
 <div id="error-state" class="hidden text-center py-12">
 <div class="text-6xl mb-4">⚠️</div>
 <h3 class="text-xl font-bold mb-2">Error loading leaderboard</h3>
 <p class="mb-4">Please try again later</p>
 <button class="btn bg-level-expert hover:bg-level-expert/80" onclick="location.reload()">
 Retry
 </button>
 </div>

 </div>
 </div>
 </div>

 <!-- Point System Explanation (full width with padding) -->
 <div class="w-full px-4 pb-8">
 <div class="w-full mt-4 bg-learning-app-design-1 shadow-card rounded-xl p-4">
 <h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
 <img src="/img/svg/01/bulb-on-svgrepo-com.svg" alt="Bulb" class="w-6 h-6">
 How Leaderboard Points Work
 </h2>
 <div class="space-y-3 text-sm">
 <div class="flex items-center gap-3">
 <div class="px-3 py-1.5 text-sm font-bold bg-level-expert rounded">+5</div>
 <div>Complete a category to earn points (repeatable every 24h)</div>
 </div>
 <div class="flex items-center gap-3">
 <div class="px-3 py-1.5 text-sm font-bold bg-level-mastered rounded">+50</div>
 <div>Score 100% on a challenge quiz</div>
 </div>
 <div class="flex items-center gap-3">
 <div class="px-3 py-1.5 text-sm font-bold bg-level-learning rounded">+20</div>
 <div>Score 90%+ on a challenge quiz</div>
 </div>
 </div>
 </div>
 </div>
 </div><!-- End Point System wrapper -->

 <%- include('partials/modals') %>

 <script defer type="module" src="/scripts/auth.js"></script>
 <script defer type="module" src="/scripts/index.js"></script>
 <script type="module">
 import { getApps, getApp, initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
 import {
 getAuth,
 onAuthStateChanged,
 } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
 import {
 getFirestore,
 collection,
 getDocs,
 query,
 orderBy,
 limit,
 doc,
 setDoc,
 serverTimestamp,
 } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

 // Firebase config
 const firebaseConfig = {
 apiKey:"AIzaSyA5TmUWOFkanWSVj-GU3SgDiKyD86yDgoQ",
 authDomain:"costam-3f612.firebaseapp.com",
 databaseURL:"https://costam-3f612-default-rtdb.firebaseio.com",
 projectId:"costam-3f612",
 storageBucket:"costam-3f612.firebasestorage.app",
 messagingSenderId:"767407380440",
 appId:"1:767407380440:web:eb4a082d596a7a69c384ad",
 };

 const app = getApps().length ? getApp() : initializeApp(firebaseConfig);
 const auth = getAuth(app);
 const db = getFirestore(app);

 let currentUser = null;
 let cachedLeaderboardData = null;

 const POINTS = {
 CATEGORY_COMPLETION: 5,
 };

 // Language configuration with flags
 const LANGUAGES = {
 es: { name:"Spanish", flag:"🇪🇸" },
 de: { name:"German", flag:"🇩🇪" },
 fr: { name:"French", flag:"🇫🇷" },
 ru: { name:"Russian", flag:"🇷🇺" },
 zh: { name:"Chinese", flag:"🇨🇳" },
 ja: { name:"Japanese", flag:"🇯🇵" },
 ko: { name:"Korean", flag:"🇰🇷" },
 it: { name:"Italian", flag:"🇮🇹" },
 };

 /**
 * Calculate user statistics from localStorage
 * CRITICAL: Verify data belongs to current user before using
 */
 function calculateUserStats() {
 const stats = {
 totalPoints: 0,
 starPoints: 0,
 challengePoints: 0,
 wordsCompleted: 0,
 starsEarned: 0,
 challengesCompleted: 0,
 languageBreakdown: {},
 };

 const storedUserId = localStorage.getItem("mc_current_user_id");
 if (!currentUser || storedUserId !== currentUser.uid) {
 return stats;
 }

 Object.keys(LANGUAGES).forEach((lang) => {
 const buttonStates = JSON.parse(
 localStorage.getItem(`buttonStates_${lang}`) ||"{}"
 );
 const repeatCounts = JSON.parse(
 localStorage.getItem(`repeatCounts_${lang}`) ||"{}"
 );
 const completionMap = JSON.parse(
 localStorage.getItem(`categoryCompletionDates_${lang}`) ||"{}"
 );

 // Count completed words (for display, not points)
 let langWordsCompleted = 0;
 Object.values(buttonStates).forEach((state) => {
 if (state.locked) {
 langWordsCompleted++;
 }
 });

 // Count stars (category completions) - 5 points each
 const langStars = Object.values(repeatCounts).reduce(
 (sum, count) => sum + (count || 0), 0
 );
 const langStarPoints = langStars * POINTS.CATEGORY_COMPLETION;

 // Count challenge bonus points
 const completionEntries = Object.values(completionMap).filter(
 (entry) => entry && typeof entry ==="object" &&"totalBonusPoints" in entry
 );
 const langChallengesCompleted = completionEntries.length;
 const langChallengePoints = completionEntries.reduce(
 (sum, entry) => sum + (entry.totalBonusPoints || entry.bonusPoints || 0),
 0
 );

 const langTotalPoints = langStarPoints + langChallengePoints;

 stats.wordsCompleted += langWordsCompleted;
 stats.starsEarned += langStars;
 stats.challengesCompleted += langChallengesCompleted;
 stats.starPoints += langStarPoints;
 stats.challengePoints += langChallengePoints;
 stats.languageBreakdown[lang] = {
 words: langWordsCompleted,
 stars: langStars,
 challenges: langChallengesCompleted,
 points: langTotalPoints,
 };
 });

 stats.totalPoints = stats.starPoints + stats.challengePoints;

 return stats;
 }

 /**
 * Sync user stats to Firestore
 */
 async function syncStatsToFirestore(userId, stats) {
 try {
 const userRef = doc(db,"leaderboard", userId);
 await setDoc(
 userRef,
 {
 userId: userId,
 displayName:
 currentUser.displayName ||
 currentUser.email?.split("@")[0] ||
"Anonymous",
 email: currentUser.email,
 totalPoints: stats.totalPoints,
 wordsCompleted: stats.wordsCompleted,
 starsEarned: stats.starsEarned || 0,
 challengesCompleted: stats.challengesCompleted || 0,
 starPoints: stats.starPoints || 0,
 challengePoints: stats.challengePoints || 0,
 languageBreakdown: stats.languageBreakdown || {},
 lastUpdated: serverTimestamp(),
 },
 { merge: true }
 );
 } catch (error) {
 console.error("Error syncing leaderboard stats:", error);
 }
 }

 /**
 * Load and display global leaderboard
 */
 async function loadLeaderboard() {
 const loadingEl = document.getElementById("loading-state");
 const contentEl = document.getElementById("leaderboard-content");
 const emptyEl = document.getElementById("empty-state");
 const errorEl = document.getElementById("error-state");

 if (cachedLeaderboardData) {
 displayLeaderboard(cachedLeaderboardData);
 return;
 }

 loadingEl.classList.remove("hidden");
 contentEl.classList.add("hidden");
 emptyEl.classList.add("hidden");
 errorEl.classList.add("hidden");

 try {
 const leaderboardRef = collection(db, "leaderboard");
 const q = query(leaderboardRef, orderBy("totalPoints", "desc"), limit(100));
 const snapshot = await getDocs(q);

 if (snapshot.empty) {
 loadingEl.classList.add("hidden");
 emptyEl.classList.remove("hidden");
 return;
 }

 cachedLeaderboardData = [];
 snapshot.forEach((doc) => {
 cachedLeaderboardData.push({ id: doc.id, ...doc.data() });
 });

 displayLeaderboard(cachedLeaderboardData);

 // Populate header user row
 if (currentUser && cachedLeaderboardData) {
 const userIndex = cachedLeaderboardData.findIndex(u => u.userId === currentUser.uid);
 if (userIndex !== -1) {
 const userData = cachedLeaderboardData[userIndex];
 const headerRow = document.getElementById('header-user-row');
 const avatarEl = document.getElementById('header-user-avatar');
 const nameEl = document.getElementById('header-user-name');
 const rankEl = document.getElementById('header-user-rank');

 if (userData.avatarUrl) {
 avatarEl.src = userData.avatarUrl;
 } else {
 avatarEl.src = `https://api.dicebear.com/7.x/adventurer/svg?seed=${currentUser.uid}`;
 }
 nameEl.textContent = userData.displayName || 'Anonymous';
 rankEl.textContent = `#${userIndex + 1}`;
 headerRow.classList.remove('hidden');
 }
 }

 loadingEl.classList.add("hidden");
 contentEl.classList.remove("hidden");
 } catch (error) {
 console.error("Error loading leaderboard:", error);
 loadingEl.classList.add("hidden");
 errorEl.classList.remove("hidden");
 }
 }

 /**
 * Display leaderboard table
 */
 function displayLeaderboard(data) {
 const tbody = document.getElementById("leaderboard-table-body");
 tbody.innerHTML ="";

 data.forEach((user, index) => {
 const globalRank = index + 1;
 const row = document.createElement("tr");

 // Base row look (mobile card background now comes from classes, not CSS)
 row.className ="bg-learning-app-design-3 hover:bg-learning-app-design-4 transition-colors shadow-card rounded-xl";

 // Highlight current user with blue background
 if (currentUser && user.userId === currentUser.uid) {
 row.className ="bg-level-learning hover:bg-level-learning transition-colors shadow-card rounded-xl";
 }

 // Medal SVG for top 3
 const medalSvg = (color) => `<svg class="w-6 h-6 inline" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2" stroke-linejoin="round"><path d="M15.9201 12.8959L19.2583 8.89003C19.533 8.5604 19.6704 8.39557 19.7681 8.21065C19.8548 8.0466 19.9183 7.87128 19.9567 7.68973C20 7.48508 20 7.27053 20 6.84144V6.2C20 5.07989 20 4.51984 19.782 4.09202C19.5903 3.71569 19.2843 3.40973 18.908 3.21799C18.4802 3 17.9201 3 16.8 3H7.2C6.0799 3 5.51984 3 5.09202 3.21799C4.71569 3.40973 4.40973 3.71569 4.21799 4.09202C4 4.51984 4 5.07989 4 6.2V6.84144C4 7.27053 4 7.48508 4.04328 7.68973C4.08168 7.87128 4.14515 8.0466 4.23188 8.21065C4.32964 8.39557 4.467 8.5604 4.74169 8.89003L8.07995 12.8959M13.4009 11.1989L19.3668 3.53988M10.5991 11.1989L4.6394 3.53414M6.55673 6H17.4505M17 16C17 18.7614 14.7614 21 12 21C9.23858 21 7 18.7614 7 16C7 13.2386 9.23858 11 12 11C14.7614 11 17 13.2386 17 16Z"/></svg>`;

 let rankDisplay = globalRank;
 if (globalRank === 1) rankDisplay = medalSvg('#2BD999');
 else if (globalRank === 2) rankDisplay = medalSvg('#4982A6');
 else if (globalRank === 3) rankDisplay = medalSvg('#4951F2');

 row.innerHTML = `
 <td class="px-4 py-3 text-center" data-label="Rank">
 <span class="font-bold text-lg">${rankDisplay}</span>
 </td>
 <th scope="row" class="px-4 py-3 font-medium min-w-0" data-label="Player">
 <div class="mobile-player-stack flex items-center gap-3 min-w-0">
 <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-learning-app-design-3 overflow-hidden">
 ${user.avatarUrl
 ? `<img src="${user.avatarUrl}" alt="Avatar" class="w-full h-full object-cover">`
 : `<span class="text-lg font-semibold">${user.displayName?.[0]?.toUpperCase() ||"?"}</span>`
 }
 </div>
 <div class="min-w-0">
 <div class="font-semibold truncate">${user.displayName ||"Anonymous"}</div>
 </div>
 </div>
 </th>
 <td class="px-4 py-3 text-center" data-label="Points">
 <span class="font-bold text-lg">${(
 user.totalPoints || 0
 ).toLocaleString()}</span>
 </td>
 `;
 tbody.appendChild(row);
 });
 }

 /**
 * Initialize page
 */
 async function init() {
 // Auth state listener
 onAuthStateChanged(auth, async (user) => {
 currentUser = user;

 if (user) {
 // Calculate user stats
 const stats = calculateUserStats();

 // Sync to Firestore
 await syncStatsToFirestore(user.uid, stats);
 }

 // Load leaderboard
 await loadLeaderboard();
 });
 }

 init();
 </script>
 </body>

</html>