<!DOCTYPE html>
<html lang="en" class="bg-learning-app-design-2">
<%- include('partials/head') %>

 <body class="m-0 p-0 bg-learning-app-design-2" style="padding-top: calc(60px + env(safe-area-inset-top, 0px));">
 <!-- Google Tag Manager (noscript) -->
 <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5L47BNJP" height="0" width="0"
 style="display:none;visibility:hidden"></iframe></noscript>
 <!-- End Google Tag Manager (noscript) -->

 <%- include('partials/menu') %>

 <div class="container mx-auto px-4 py-8 max-w-2xl safe-bottom">
 <div id="profile-page-status" class="hidden"></div>

 <!-- Loading State -->
 <div id="profile-loading" class="text-center py-16 space-y-4">
 <span class="loading loading-spinner loading-lg"></span>
 <p class="text-sm">Loading your profile settings...</p>
 </div>

 <!-- Login Required -->
 <div id="login-required" class="hidden">
 <div class="text-center py-16">
 <div class="mb-6">
 <svg class="w-20 h-20 mx-auto" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
 stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
 </svg>
 </div>
 <h2 class="text-2xl font-bold mb-3">Sign in to view your profile</h2>
 <p class="mb-6">Manage your account settings and customize your avatar.</p>
 <label for="modal-login"
 class="inline-flex items-center justify-center rounded-full py-3 px-8 text-sm font-semibold bg-level-learning text-white border-0 cursor-pointer">
 Sign In
 </label>
 </div>
 </div>

 <!-- Profile Content -->
 <div id="profile-content" class="hidden space-y-8">
 <!-- Header card -->
 <div class="rounded-xl bg-learning-app-design-1 p-4 shadow-card">
 <p class="text-xl font-semibold mb-3">Your Profile</p>
 <p class="text-xs opacity-50">Customize your account</p>
 </div>

 <!-- Avatar Section -->
 <div class="bg-learning-app-design-1 rounded-xl p-5 sm:p-6 shadow-card">
 <h2 class="text-xl font-semibold mb-3">Avatar</h2>

 <div class="flex flex-col sm:flex-row items-center gap-6">
 <!-- Current Avatar Preview -->
 <div class="flex-shrink-0">
 <div id="avatar-preview"
 class="w-32 h-32 rounded-full bg-learning-app-design-3 overflow-hidden">
 <img id="current-avatar" src="" alt="Avatar" class="w-full h-full object-cover">
 </div>
 </div>

 <!-- Avatar Controls -->
 <div class="flex-1 w-full space-y-4">
 <!-- Style Selector -->
 <div>
 <label class="block text-sm opacity-60 mb-2">Avatar Style</label>
 <select id="avatar-style"
 class="select select-bordered w-full bg-learning-app-design-3">
 <option value="adventurer">Adventurer</option>
 <option value="adventurer-neutral">Adventurer Neutral</option>
 <option value="avataaars">Avataaars</option>
 <option value="big-ears">Big Ears</option>
 <option value="big-smile">Big Smile</option>
 <option value="bottts">Robots</option>
 <option value="croodles">Croodles</option>
 <option value="fun-emoji">Fun Emoji</option>
 <option value="icons">Icons</option>
 <option value="identicon">Identicon</option>
 <option value="initials">Initials</option>
 <option value="lorelei">Lorelei</option>
 <option value="micah">Micah</option>
 <option value="miniavs">Miniavs</option>
 <option value="notionists">Notionists</option>
 <option value="open-peeps">Open Peeps</option>
 <option value="personas">Personas</option>
 <option value="pixel-art">Pixel Art</option>
 <option value="shapes">Shapes</option>
 <option value="thumbs">Thumbs</option>
 </select>
 </div>

 <!-- Generate Button -->
 <div class="flex gap-2">
 <button id="generate-avatar-btn" class="inline-flex items-center justify-center gap-2 rounded-full py-3 px-4 text-sm font-semibold bg-learning-app-design-3 border-0 flex-1">
 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
 </svg>
 Generate Random
 </button>
 </div>
 </div>
 </div>
 </div>

 <!-- Display Name Section -->
 <div class="bg-learning-app-design-1 rounded-xl p-5 sm:p-6 shadow-card">
 <h2 class="text-xl font-semibold mb-3">Display Name</h2>

 <div class="space-y-4">
 <div>
 <label class="block text-sm opacity-60 mb-2">Your name (visible on leaderboard)</label>
 <input type="text" id="display-name-input"
 class="input input-bordered touch-target w-full bg-learning-app-design-3"
 placeholder="Enter your display name" maxlength="20">
 <p class="text-xs opacity-40 mt-1">Max 20 characters. Letters, numbers, and spaces only.</p>
 </div>
 </div>
 </div>

 <!-- Account Info Section -->
 <div class="bg-learning-app-design-1 rounded-xl p-5 sm:p-6 shadow-card">
 <h2 class="text-xl font-semibold mb-3">Account Info</h2>

 <div class="divide-y divide-learning-app-design-3">
 <div class="flex items-center justify-between py-3">
 <span class="text-sm opacity-60">Email</span>
 <span id="user-email" class="text-sm font-semibold"></span>
 </div>
 <div class="flex items-center justify-between py-3">
 <span class="text-sm opacity-60">Account Type</span>
 <span id="account-type" class="text-sm font-semibold"></span>
 </div>
 <div id="trial-info-row" class="hidden flex items-center justify-between py-3">
 <span class="text-sm opacity-60">Free Trial</span>
 <span id="trial-status" class="text-sm font-semibold"></span>
 </div>
 <div class="flex items-center justify-between py-3">
 <span class="text-sm opacity-60">Member Since</span>
 <span id="member-since" class="text-sm font-semibold"></span>
 </div>
 </div>
 </div>

 <!-- Save Button -->
 <div class="flex flex-col sm:flex-row gap-3">
 <button id="save-profile-btn" class="inline-flex items-center justify-center gap-2 rounded-full py-3 px-6 text-sm font-semibold bg-level-learning text-white border-0 flex-1">
 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
 </svg>
 Save Changes
 </button>
 <a href="/learn" class="inline-flex items-center justify-center rounded-full py-3 px-6 text-sm font-semibold bg-level-expert text-white border-0">
 Back to Learning
 </a>
 </div>

 <!-- Danger Zone -->
 <div class="bg-learning-app-design-1 rounded-xl p-5 sm:p-6 shadow-card border border-red-500/30">
 <h2 class="text-xl font-semibold mb-2">Delete Account</h2>
 <p class="text-sm opacity-60 mb-4">Permanently deletes your account and all data associated with it (profile, learning progress, leaderboard entry). This cannot be undone.</p>
 <label for="modal-delete-account"
 class="inline-flex items-center justify-center rounded-full py-3 px-6 text-sm font-semibold bg-red-600 text-white border-0 cursor-pointer">
 Delete Account
 </label>
 </div>

 <!-- Success/Error Messages -->
 <div id="save-success" class="hidden alert alert-success">
 <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none"
 viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
 d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 <span>Profile saved successfully!</span>
 </div>
 <div id="save-error" class="hidden alert alert-error">
 <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none"
 viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
 d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 <span id="error-message">Error saving profile. Please try again.</span>
 </div>
 </div>
 </div>

 <!-- Modal usuwania konta -->
 <input type="checkbox" id="modal-delete-account" class="modal-toggle" />
 <div class="modal modal-bottom sm:modal-middle">
 <div class="modal-box bg-learning-app-design-2 text-base-content">
 <h3 class="font-bold text-lg">Delete Account</h3>
 <p class="text-sm opacity-70 mt-2">This permanently deletes your account and all associated data. This cannot be undone. Your App Store/Google Play subscription (if any) is not affected — cancel it separately in your device's subscription settings.</p>
 <form id="delete-account-form" class="space-y-4 mt-4">
 <input type="password" id="delete-account-password" placeholder="Confirm your password" autocomplete="current-password"
 class="input input-bordered w-full" required />
 <p id="delete-account-error" class="hidden text-sm text-red-500"></p>
 <div class="modal-action">
 <label for="modal-delete-account" class="inline-flex items-center justify-center rounded-full py-3 px-6 text-sm font-semibold bg-learning-app-design-3 border-0 cursor-pointer">Cancel</label>
 <button type="submit" id="delete-account-confirm-btn" class="inline-flex items-center justify-center rounded-full py-3 px-6 text-sm font-semibold bg-red-600 text-white border-0">
 Permanently Delete
 </button>
 </div>
 </form>
 </div>
 </div>

 <!-- Modale -->
 <%- include('partials/modals') %>

 <script defer type="module" src="/scripts/auth.js"></script>
 <script defer type="module" src="/scripts/index.js"></script>
 <script defer type="module" src="/scripts/services/premiumService.js"></script>
 <script defer type="module" src="/scripts/services/syncService.js"></script>
 <script defer type="module" src="/scripts/pages/profile.js"></script>
 </body>

</html>