<!DOCTYPE html>
<html lang="en" class="bg-learning-app-design-2">
<%- include('partials/head') %>

 <body class="m-0 p-0 bg-learning-app-design-2" style="padding-top: calc(60px + env(safe-area-inset-top, 0px));">
 <!-- Google Tag Manager (noscript) -->
 <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5L47BNJP" height="0" width="0"
 style="display:none;visibility:hidden"></iframe></noscript>
 <!-- End Google Tag Manager (noscript) -->

 <%- include('partials/menu') %>

 <div class="container mx-auto px-4 py-8 pt-12 max-w-5xl safe-bottom">

 <!-- Header -->
 <div class="text-center mb-4 px-4">
 <h1 class="text-3xl sm:text-4xl font-bold mb-2">Start your language journey today
 </h1>
 <p class="py-5 sm:py-8 max-w-xl mx-auto">8 languages • 12,000+ words • Global competition</p>
 </div>

 <!-- Pricing Cards Container -->
 <div id="price-cards"
 class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-7xl mx-auto mb-4">

 <!-- Free Plan -->
 <div
 class="bg-learning-app-design-1 shadow-card hover:shadow-card-hover hover:-translate-y-[5px] transition-all duration-300 ease-in-out rounded-xl p-5 flex flex-col">
 <h3 class="font-bold mb-2">Free</h3>
 <p class="text-xs mb-2">7 days full access trial!</p>
 <p class="text-2xl font-bold mb-6">$0</p>
 <ul class="text-sm mb-6 space-y-2 mt-auto">
 <li>✓ 1 category per language</li>
 <li>✓ Audio pronunciation</li>
 <li>✓ Category Challenge</li>
 <li>✓ Statistics</li>
 <li class="">✗ Limited Leaderboard</li>
 </ul>
 <div>
 <button
 class="inline-flex items-center justify-center rounded-full py-3 px-4 text-sm font-semibold bg-learning-app-design-4 text-white border-0 w-full"
 onclick="window.location.href='/learn'">
 Start for free
 </button>
 </div>
 </div>

 <!-- Monthly Plan -->
 <div
 class="bg-learning-app-design-1 shadow-card hover:shadow-card-hover hover:-translate-y-[5px] transition-all duration-300 ease-in-out rounded-xl p-5 flex flex-col">
 <h3 class="font-bold mb-2">Monthly</h3>
 <p class="text-xs mb-2">Flexible, cancel anytime</p>
 <p class="text-2xl font-bold mb-6" data-iap-price="monthly"><span data-iap-amount>$9.99</span><span class="text-sm">/month</span></p>
 <ul class="text-sm mb-6 space-y-2 mt-auto">
 <li class="">✓ All categories unlocked</li>
 <li>✓ Audio pronunciation</li>
 <li>✓ Category Challenge</li>
 <li>✓ Statistics</li>
 <li class="">✓ Unlimited Leaderboard</li>
 </ul>
 <div>
 <button
 class="iap-cta inline-flex items-center justify-center rounded-full py-3 px-4 text-sm font-semibold bg-level-expert text-white border-0 w-full"
 data-iap-package="monthly"
 type="button">
 Buy monthly in app
 </button>
 </div>
 </div>

 <!-- Yearly Plan -->
 <div
 class="bg-learning-app-design-1 shadow-card hover:shadow-card-hover hover:-translate-y-[5px] transition-all duration-300 ease-in-out rounded-xl p-5 flex flex-col relative">
 <div
 class="absolute top-0 right-0 bg-level-expert text-xs font-bold px-2 py-1 rounded-bl-lg rounded-tr-[10px]">
 BEST VALUE
 </div>
 <h3 class="font-bold mb-2">Yearly</h3>
 <p class="text-xs mb-2">Best value for subscriptions</p>
 <p class="text-2xl font-bold mb-1" data-iap-price="annual"><span data-iap-amount>$59</span><span class="text-sm">/year</span></p>
 <p class="text-xs mb-6" data-iap-monthly-equiv>~$5/month</p>
 <ul class="text-sm mb-6 space-y-2 mt-auto">
 <li class="">✓ All categories unlocked</li>
 <li>✓ Audio pronunciation</li>
 <li>✓ Category Challenge</li>
 <li>✓ Statistics</li>
 <li class="">✓ Unlimited Leaderboard</li>
 </ul>
 <div>
 <button
 class="iap-cta inline-flex items-center justify-center rounded-full py-3 px-4 text-sm font-semibold bg-level-expert text-white border-0 w-full"
 data-iap-package="annual"
 type="button">
 Buy yearly in app
 </button>
 </div>
 </div>

 <!-- Lifetime Plan -->
 <div
 class="bg-learning-app-design-1 shadow-card hover:shadow-card-hover hover:-translate-y-[5px] transition-all duration-300 ease-in-out rounded-xl p-5 flex flex-col">
 <h3 class="font-bold mb-2">Lifetime</h3>
 <p class="text-xs mb-2">One-time payment, forever access</p>
 <p class="text-2xl font-bold mb-1" data-iap-price="lifetime"><span data-iap-amount>$99</span><span class="text-sm"> one-time</span></p>
 <p class="text-xs mb-6">Own it forever</p>
 <ul class="text-sm mb-6 space-y-2 mt-auto">
 <li class="">✓ All categories unlocked</li>
 <li>✓ Audio pronunciation</li>
 <li>✓ Category Challenge</li>
 <li>✓ Statistics</li>
 <li class="">✓ Unlimited Leaderboard</li>
 </ul>
 <div>
 <button
 class="iap-cta inline-flex items-center justify-center rounded-full py-3 px-4 text-sm font-semibold bg-level-expert text-white border-0 w-full"
 data-iap-package="lifetime"
 type="button">
 Buy lifetime in app
 </button>
 </div>
 </div>
 </div>

 <div class="text-center mb-4 px-4 max-w-3xl mx-auto">
 <p id="iap-status" class="text-sm" role="status" aria-live="polite"></p>
 <p id="iap-price-note" class="hidden mt-2 text-xs">Final price and currency are shown by Apple App Store or Google Play at checkout.</p>

 <div class="mt-6">
 <p class="text-xs opacity-50 mb-2">Already purchased on another device?</p>
 <button id="iap-restore"
 class="text-sm underline opacity-70 hover:opacity-100 bg-transparent border-0 cursor-pointer"
 type="button">
 Restore purchases
 </button>
 <p class="text-xs opacity-40 mt-1">Reinstalled the app or switched devices? Tap to recover your Premium access.</p>
 </div>

 <!-- Dev only: native paywall trigger (hidden from users) -->
 <button
 class="hidden"
 data-iap-native-paywall
 type="button">
 Open Native Paywall
 </button>
 </div>

 <!-- Features List -->
 <div id="features-list" class="hidden max-w-2xl mx-auto mb-4 px-4">
 <h3 class="text-center font-semibold mb-6">What's included in Premium:</h3>
 <div class="grid grid-cols-1 gap-4 max-w-md mx-auto">
 <div class="flex items-center gap-3">
 <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24"
 stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
 </svg>
 <span>All categories in 8 languages</span>
 </div>
 <div class="flex items-center gap-3">
 <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24"
 stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
 </svg>
 <span>Unlimited daily challenges</span>
 </div>
 <div class="flex items-center gap-3">
 <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24"
 stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
 </svg>
 <span>Unlimited Leaderboard points</span>
 </div>
 </div>
 </div>

 <!-- karta dla premium user -->
 <div id="user-card" class="hidden w-full max-w-md mx-auto">

 <div class="bg-learning-app-design-1 shadow-card rounded-xl overflow-hidden">
 <div class="p-6 text-center">
 <div class="w-16 h-16 bg-learning-app-design-5 rounded-full flex items-center justify-center mx-auto mb-4">
 <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
 </svg>
 </div>

 <h2 class="text-2xl font-bold mb-2">You're Premium!</h2>
 <p class="mb-6">Full access to all 8 languages and 12,000+ words</p>

 <div class="bg-learning-app-design-2 rounded-lg p-4 mb-6">
 <p class="text-sm">Thank you for supporting Zentalist. Good luck climbing the
 leaderboards!</p>
 </div>

 <a href="/learn"
 class="inline-flex items-center gap-2 rounded-full py-3 px-6 text-sm font-semibold bg-learning-app-design-5 text-white border-0">
 Start Playing
 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
 </svg>
 </a>
 </div>
 </div>
 </div>
 <!-- koniec karty dla premium user -->

 </div><!-- koniec kontenera max-w-5xl -->

 <!-- Modale -->
 <%- include('partials/modals') %>

 <script defer type="module" src="/scripts/auth.js"></script>
 <script defer type="module" src="/scripts/index.js"></script>
 <script defer type="module" src="/scripts/pages/premiumPaywall.js"></script>
 </body>

</html>