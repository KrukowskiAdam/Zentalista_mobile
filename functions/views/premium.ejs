<!DOCTYPE html>
<html lang="en" style="background-color: #030712;">
<%- include('partials/head') %>

  <body class="m-0 p-0 bg-dark-bg text-gray-200" style="padding-top: 80px;">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5L47BNJP" height="0" width="0"
        style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <%- include('partials/menu') %>

      <div class="container mx-auto px-4 py-8 pt-12 max-w-5xl safe-bottom">

        <!-- Header -->
        <div class="text-center mb-8 px-2">
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-100 mb-2">Start your language journey today
          </h1>
          <p class="text-gray-400 py-5 sm:py-8 max-w-xl mx-auto">8 languages • 30,000+ words • Global competition</p>
        </div>

        <!-- Pricing Cards Container -->
        <div id="price-cards"
          class="hidden grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5 max-w-7xl mx-auto mb-10">

          <!-- Free Plan -->
          <div
            class="bg-dark-bg border border-dark-border shadow-card hover:shadow-card-hover hover:-translate-y-[5px] transition-all duration-300 ease-in-out rounded-xl p-5 flex flex-col">
            <h3 class="font-bold text-white mb-2">Free</h3>
            <p class="text-level-expert text-xs mb-2">7 days full access trial!</p>
            <p class="text-2xl text-white font-bold mb-6">$0</p>
            <ul class="text-sm text-gray-300 mb-6 space-y-2 mt-auto">
              <li>✓ 1 category per language</li>
              <li>✓ Audio pronunciation</li>
              <li>✓ Category Challenge</li>
              <li>✓ Statistics</li>
              <li class="text-gray-500">✗ Limited Leaderboard</li>
            </ul>
            <div>
              <button
                class="bg-dark-border hover:bg-gray-600 text-white font-bold py-3 px-4 rounded-md text-base w-full"
                onclick="window.location.href='/learn'">
                Start for free
              </button>
            </div>
          </div>

          <!-- Monthly Plan -->
          <div
            class="bg-dark-bg border border-dark-border shadow-card hover:shadow-card-hover hover:-translate-y-[5px] transition-all duration-300 ease-in-out rounded-xl p-5 flex flex-col">
            <h3 class="font-bold text-white mb-2">Monthly</h3>
            <p class="text-gray-400 text-xs mb-2">Flexible, cancel anytime</p>
            <p class="text-2xl text-white font-bold mb-6">$9.99<span class="text-sm text-gray-400">/month</span></p>
            <ul class="text-sm text-gray-300 mb-6 space-y-2 mt-auto">
              <li class="text-green-400">✓ All categories unlocked</li>
              <li>✓ Audio pronunciation</li>
              <li>✓ Category Challenge</li>
              <li>✓ Statistics</li>
              <li class="text-green-400">✓ Unlimited Leaderboard</li>
            </ul>
            <div>
              <button
                class="iap-cta touch-target bg-level-expert hover:bg-level-expert/80 text-white font-bold py-3 px-4 rounded-md text-base w-full"
                data-iap-package="monthly"
                type="button">
                Buy monthly in app
              </button>
            </div>
          </div>

          <!-- Yearly Plan -->
          <div
            class="bg-dark-bg border-2 border-level-expert shadow-card hover:shadow-card-hover hover:-translate-y-[5px] transition-all duration-300 ease-in-out rounded-xl p-5 flex flex-col relative">
            <div
              class="absolute top-0 right-0 bg-level-expert text-white text-xs font-bold px-2 py-1 rounded-bl-lg rounded-tr-[10px]">
              BEST VALUE
            </div>
            <h3 class="font-bold text-white mb-2">Yearly</h3>
            <p class="text-gray-400 text-xs mb-2">Best value for subscriptions</p>
            <p class="text-2xl text-white font-bold mb-1">$59<span class="text-sm text-gray-400">/year</span></p>
            <p class="text-level-expert text-xs mb-6">~$5/month</p>
            <ul class="text-sm text-gray-300 mb-6 space-y-2 mt-auto">
              <li class="text-green-400">✓ All categories unlocked</li>
              <li>✓ Audio pronunciation</li>
              <li>✓ Category Challenge</li>
              <li>✓ Statistics</li>
              <li class="text-green-400">✓ Unlimited Leaderboard</li>
            </ul>
            <div>
              <button
                class="iap-cta touch-target bg-level-expert hover:bg-level-expert/80 text-white font-bold py-3 px-4 rounded-md text-base w-full"
                data-iap-package="annual"
                type="button">
                Buy yearly in app
              </button>
            </div>
          </div>

          <!-- Lifetime Plan -->
          <div
            class="bg-dark-bg border border-dark-border shadow-card hover:shadow-card-hover hover:-translate-y-[5px] transition-all duration-300 ease-in-out rounded-xl p-5 flex flex-col">
            <h3 class="font-bold text-white mb-2">Lifetime</h3>
            <p class="text-gray-400 text-xs mb-2">One-time payment, forever access</p>
            <p class="text-2xl text-white font-bold mb-1">$99<span class="text-sm text-gray-400"> one-time</span></p>
            <p class="text-green-400 text-xs mb-6">Own it forever</p>
            <ul class="text-sm text-gray-300 mb-6 space-y-2 mt-auto">
              <li class="text-green-400">✓ All categories unlocked</li>
              <li>✓ Audio pronunciation</li>
              <li>✓ Category Challenge</li>
              <li>✓ Statistics</li>
              <li class="text-green-400">✓ Unlimited Leaderboard</li>
            </ul>
            <div>
              <button
                class="iap-cta touch-target bg-level-expert hover:bg-level-expert/80 text-white font-bold py-3 px-4 rounded-md text-base w-full"
                data-iap-package="lifetime"
                type="button">
                Buy lifetime in app
              </button>
            </div>
          </div>
        </div>

        <div class="text-center mb-10 px-2 max-w-3xl mx-auto">
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <button
            class="touch-target inline-flex items-center justify-center px-5 py-3 rounded-md bg-level-expert hover:bg-level-expert/80 text-white font-semibold"
            data-iap-native-paywall
            type="button">
            Open Native Paywall (1-click test)
          </button>

          <button id="iap-restore"
            class="touch-target inline-flex items-center justify-center px-5 py-3 rounded-md border border-dark-border text-gray-200 hover:bg-dark-card"
            type="button">
            Restore purchases
          </button>
          </div>
          <p id="iap-status" class="mt-3 text-sm text-gray-300" role="status" aria-live="polite"></p>
          <p id="iap-price-note" class="hidden mt-2 text-xs text-gray-400">Final price and currency are shown by Apple App Store or Google Play at checkout.</p>
        </div>

        <!-- Features List -->
        <div id="features-list" class="hidden max-w-2xl mx-auto mb-10 px-2">
          <h3 class="text-center text-white font-semibold mb-6">What's included in Premium:</h3>
          <div class="grid grid-cols-1 gap-4 max-w-md mx-auto">
            <div class="flex items-center gap-3 text-gray-300">
              <svg class="w-5 h-5 text-level-expert flex-shrink-0" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>All categories in 8 languages</span>
            </div>
            <div class="flex items-center gap-3 text-gray-300">
              <svg class="w-5 h-5 text-level-expert flex-shrink-0" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Unlimited daily challenges</span>
            </div>
            <div class="flex items-center gap-3 text-gray-300">
              <svg class="w-5 h-5 text-level-expert flex-shrink-0" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Unlimited Leaderboard points</span>
            </div>
          </div>
        </div>

        <!-- karta dla premium user -->
        <div id="user-card" class="hidden w-full max-w-md mx-auto">

          <div class="bg-dark-card border border-green-500/30 rounded-xl overflow-hidden">
            <div class="p-6 text-center">
              <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>

              <h2 class="text-2xl font-bold text-white mb-2">You're Premium!</h2>
              <p class="text-gray-400 mb-6">Full access to all 8 languages and 30,000+ words</p>

              <div class="bg-dark-bg rounded-lg p-4 mb-6">
                <p class="text-gray-300 text-sm">Thank you for supporting Zentalist. Good luck climbing the
                  leaderboards!</p>
              </div>

              <a href="/learn"
                class="inline-flex items-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-medium rounded-lg transition-colors">
                Start Playing
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
        <!-- koniec karty dla premium user -->

      </div><!-- koniec kontenera max-w-5xl -->

        <!-- Modale -->
        <%- include('partials/modals') %>

          <script defer type="module" src="/scripts/auth.js"></script>
          <script defer type="module" src="/scripts/index.js"></script>
          <script defer type="module" src="/scripts/pages/premiumPaywall.js"></script>
  </body>

</html>