<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

 <body class="m-0 p-0 bg-learning-app-design-2 safe-bottom" data-app-mode="<%= isAppHome ? 'home' : 'learn' %>">
 <!-- Google Tag Manager (noscript) -->
 <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5L47BNJP" height="0" width="0"
 style="display:none;visibility:hidden"></iframe></noscript>
 <!-- End Google Tag Manager (noscript) -->
 <%- include('partials/menu') %>

 <!-- Mobile sidebar toggle button -->
 <button id="sidebar-toggle"
 class="fixed z-40 btn btn-circle touch-target bg-level-expert hover:bg-level-expert-dark shadow-lg border-0 <%= isAppHome ? 'hidden' : '' %>"
 style="right: max(1rem, constant(safe-area-inset-right)); right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, constant(safe-area-inset-bottom)); bottom: max(1rem, env(safe-area-inset-bottom));">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
 </svg>
 </button>

 <div id="main-container">
 <!-- Sidebar with responsive behavior -->
 <aside id="sidebar"
 class="pl-0 transition-all duration-300 bg-learning-app-design-2<%= isAppHome ? ' hidden' : '' %>">
 <h2 id="categories"
 class="text-xl bg-learning-app-design-2 font-semibold px-4 py-4">
 Categories
 </h2>
 <div id="slider">
 <div id="category-sidebar-menu">
 <!-- Kategorie będą dodawane dynamicznie jako DaisyUI accordions z join -->
 </div>
 </div>
 </aside>

 <div id="main-content" class="">
 <!-- Content goes here -->
 </div>
 </div>

 <%- include('partials/modals') %>

 <!-- Skrypty -->
 <script src="/scripts/vendors/lottie_light.min.js" defer></script>
 <script defer type="module" src="/scripts/auth.js"></script>
 <script defer type="module" src="/scripts/index.js"></script>
 <script defer type="module" src="/scripts/main.js"></script>
 <script>
 document.addEventListener("DOMContentLoaded", () => {
 const isHomeMode = document.body?.dataset?.appMode === 'home';

 // Inicjuj aplikację po załadowaniu strony
 if (window.initApp && typeof window.initApp === 'function') {
 window.initApp();
 }

 if (isHomeMode) {
 return;
 }

 // Setup mobile sidebar toggle
 const sidebarToggle = document.getElementById('sidebar-toggle');
 const sidebar = document.getElementById('sidebar');
 const mainContainer = document.getElementById('main-container');

 if (!sidebarToggle || !sidebar || !mainContainer) {
 return;
 }

 // Mobile-only app: hide sidebar by default
 sidebar.classList.add('hidden');
 mainContainer.classList.add('sidebar-hidden');

 sidebarToggle.addEventListener('click', () => {
 const isOpening = sidebar.classList.contains('hidden');
 sidebar.classList.toggle('hidden');
 mainContainer.classList.toggle('sidebar-hidden');
 if (isOpening) {
 document.querySelectorAll('#category-sidebar-menu input[type="checkbox"]').forEach(cb => cb.checked = false);
 }
 });

 // Auto-open sidebar if navigated from home "Start learning" button
 if (localStorage.getItem('autoOpenSidebar') === 'true') {
 localStorage.removeItem('autoOpenSidebar');
 sidebar.classList.remove('hidden');
 mainContainer.classList.remove('sidebar-hidden');
 // Close all accordions after sidebar renders (100ms > 50ms debounce in updateCategorySidebar)
 setTimeout(() => {
 document.querySelectorAll('#category-sidebar-menu input[type="checkbox"]').forEach(cb => cb.checked = false);
 }, 100);
 }

 // Close sidebar when a category is selected (categories are built dynamically)
 window.addEventListener('categoryChanged', () => {
 sidebar.classList.add('hidden');
 mainContainer.classList.add('sidebar-hidden');
 });
 });
 </script>

 <!-- Add necessary styles -->
 <style>
 #main-container {
 display: flex;
 flex-direction: column;
 }

 #sidebar {
 position: fixed;
 left: 0;
 top: calc(60px + constant(safe-area-inset-top));
 top: calc(60px + env(safe-area-inset-top, 0px));
 bottom: 0;
 width: 100%;
 margin-left: 0;
 margin-top: 0;
 z-index: 30;
 box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
 overflow-y: auto;
 }

 #category-sidebar-menu .join-item:last-child {
 border-bottom-left-radius: 0 !important;
 border-bottom-right-radius: 0 !important;
 }

 #main-content {
 width: 100%;
 transition: margin-left 0.3s ease;
 padding-top: calc(60px + constant(safe-area-inset-top));
 padding-top: calc(60px + env(safe-area-inset-top, 0px));
 }

 .sidebar-hidden #main-content {
 margin-left: 0;
 }
 </style>
 </body>

</html>