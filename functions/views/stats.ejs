 // Helper function to update localStorage safely
 // IMPORTANT: Preserves challenge data objects, only updates simple timestamps
 function updateLocalStorage(updates) {
 try {
 const currentLang = getCurrentLanguage();
 const savedDates = JSON.parse(
 localStorage.getItem(
 `categoryCompletionDates_${currentLang}`
 ) ||"{}"
 );

 // Don't overwrite challenge data objects with simple timestamps
 Object.entries(updates).forEach(([key, value]) => {
 const existing = savedDates[key];
 // If existing data is a challenge object (has totalBonusPoints), don't overwrite with timestamp
 if (existing && typeof existing === 'object' && 'totalBonusPoints' in existing) {
 // Only allow resetting metadata keys like :reset, :inProgress
 if (!key.includes(':')) {
 return; // Skip - don't overwrite challenge data
 }
 }
 savedDates[key] = value;
 });

 localStorage.setItem(
 `categoryCompletionDates_${currentLang}`,
 JSON.stringify(savedDates)
 );
 } catch (e) {
 console.error("Error updating localStorage:", e);
 }
 }

 // Logika obsługi przycisków w kolumnie Actions
 function setupRestartHandlers() {
 // Handle"Repeat" buttons - reset category and navigate
 document.querySelectorAll(".restart-btn").forEach((btn) => {
 btn.onclick = function () {
 const source = btn.getAttribute("data-source");
 const category = btn.getAttribute("data-category");
 const key = `${source}::${category}`;

 console.log('🔄 Review button clicked:', { source, category });

 // Find the actual completion date to preserve it
 let completionDate = null;
 if (
 categoryStats[source] &&
 categoryStats[source].categories[category]
 ) {
 completionDate =
 categoryStats[source].categories[category].lastLockedDate;
 }

 // Reset directly in localStorage
 try {
 const currentLang = getCurrentLanguage();
 const buttonStatesKey = `buttonStates_${currentLang}`;
 let buttonStates = JSON.parse(localStorage.getItem(buttonStatesKey) || '{}');

 console.log('📦 Before reset:', Object.keys(buttonStates).length, 'buttons');

 // Reset all buttons in this category
 let resetCount = 0;
 Object.entries(buttonStates).forEach(([key, state]) => {
 if (state?.source === source && state?.category === category) {
 state.locked = false;
 state.count = 0;
 state.clicks = [];
 state.lastClicked = null;
 state.wasReset = true;
 state.resetTime = Date.now();
 resetCount++;
 }
 });

 console.log('✅ Reset', resetCount, 'buttons in category');

 // Save back to localStorage
 localStorage.setItem(buttonStatesKey, JSON.stringify(buttonStates));

 } catch (error) {
 console.error('❌ Error resetting category in localStorage:', error);
 }

 // Update localStorage with all needed changes
 const updates = {
 [`${key}:reset`]: Date.now(),
 };

 // Keep completion date for display if it exists
 if (completionDate) {
 updates[key] = completionDate;
 }

 updateLocalStorage(updates);

 // Clear progress flags separately
 try {
 const currentLang = getCurrentLanguage();
 const savedDates = JSON.parse(
 localStorage.getItem(
 `categoryCompletionDates_${currentLang}`
 ) ||"{}"
 );
 delete savedDates[`${key}:inProgress`];
 localStorage.setItem(
 `categoryCompletionDates_${currentLang}`,
 JSON.stringify(savedDates)
 );
 } catch (e) {
 console.error("Error clearing progress flags", e);
 }

 // Save target category to localStorage for learn page navigation
 try {
 localStorage.setItem(
"openCategory",
 JSON.stringify({
 source: source,
 category: category,
 timestamp: Date.now(),
 })
 );
 } catch (e) {
 console.error("Error saving target category", e);
 }

 // Force sync to cloud immediately after reset
 if (window.syncService && typeof window.syncService.syncToCloud === 'function') {
 console.log('☁️ Forcing sync to cloud after reset...');
 window.syncService.syncToCloud().then(() => {
 console.log('✅ Cloud sync complete');
 // Redirect after sync completes
 window.location.href ="/learn";
 }).catch((err) => {
 console.error('❌ Cloud sync failed:', err);
 // Redirect anyway
 window.location.href ="/learn";
 });
 } else {
 console.log('🚀 Redirecting to /learn (no sync service)...');
 // Redirect to learn page
 window.location.href ="/learn";
 }
 };
 });

 // Handle"Continue" buttons - just navigate without reset
 document.querySelectorAll(".continue-btn").forEach((btn) => {
 btn.onclick = function () {
 const source = btn.getAttribute("data-source");
 const category = btn.getAttribute("data-category");

 // Save target category to localStorage for learn page navigation
 try {
 localStorage.setItem(
"openCategory",
 JSON.stringify({
 source: source,
 category: category,
 timestamp: Date.now(),
 })
 );
 } catch (e) {
 console.error("Error saving target category", e);
 }

 // Redirect to learn page to continue learning
 window.location.href ="/learn";
 };
 });

 // Handle"Start" buttons - navigate to begin learning new category
 document.querySelectorAll(".start-btn").forEach((btn) => {
 btn.onclick = function () {
 const source = btn.getAttribute("data-source");
 const category = btn.getAttribute("data-category");

 // Save target category to localStorage for learn page navigation
 try {
 localStorage.setItem(
"openCategory",
 JSON.stringify({
 source: source,
 category: category,
 timestamp: Date.now(),
 })
 );
 } catch (e) {
 console.error("Error saving target category", e);
 }

 // Redirect to learn page to start learning
 window.location.href ="/learn";
 };
 });
 }

 fillTotalWords();
 fillUserProgress();

 // Fill All Languages Progress table
 fillAllLanguagesProgress();

 // Initialize the section selector and render the first available section
 initSectionSelector();

 const statsContainer = document.getElementById("stats-container");
 if (statsContainer.children.length === 0) {
 const noDataDiv = document.createElement("div");
 noDataDiv.className ="text-center py-8 rounded-xl bg-learning-app-design-1 shadow-card";
 noDataDiv.innerHTML = `
 <p class="text-sm">No statistics yet.</p>
 <p class="text-xs mt-1">Start learning categories to populate your progress overview.</p>
 `;
 statsContainer.appendChild(noDataDiv);
 return;
 }
 }

 setTimeout(renderStats, 2000);

 setTimeout(() => {
 if (window.AppState) {
 if (typeof window.AppState.on ==="function") {
 window.AppState.on("stateChanged", renderStats);
 } else {
 let previousStateJSON = JSON.stringify(
 window.AppState.buttonStates || {}
 );
 const stateMonitor = setInterval(() => {
 if (!window.AppState || !window.AppState.buttonStates) {
 clearInterval(stateMonitor);
 return;
 }
 const currentStateJSON = JSON.stringify(
 window.AppState.buttonStates || {}
 );
 if (currentStateJSON !== previousStateJSON) {
 previousStateJSON = currentStateJSON;
 renderStats();
 }
 }, 2000);
 window.addEventListener("beforeunload", () => {
 clearInterval(stateMonitor);
 });
 }
 }
 }, 2500);
 });
 </script>
 </body>

