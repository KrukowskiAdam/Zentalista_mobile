        <!-- Modale -->
        <%- include('partials/modals') %>

          <script defer type="module" src="/scripts/main.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", () => {
              if (window.initApp) {
                window.initApp();
              }

              // Show/hide stats based on login status
              function updateStatsVisibility(forceShow = false) {
                const authLoading = document.getElementById('auth-loading');
                const loginScreen = document.getElementById('login-required-screen');
                const statsContent = document.getElementById('stats-content');
                if (!loginScreen || !statsContent) return;

                // Check if user is logged in
                const isLoggedIn = window.auth?.currentUser || window.currentUser;

                if (isLoggedIn) {
                  if (authLoading) authLoading.classList.add('hidden');
                  loginScreen.classList.add('hidden');
                  statsContent.classList.remove('hidden');
                } else if (forceShow) {
                  // Only show login screen after we're sure auth has loaded
                  if (authLoading) authLoading.classList.add('hidden');
                  loginScreen.classList.remove('hidden');
                  statsContent.classList.add('hidden');
                }
              }

              function setStatsPageStatus(message, tone = 'info') {
                const statusEl = document.getElementById('stats-page-status');
                if (!statusEl) return;

                const toneClass =
                  tone === 'error'
                    ? 'border-red-500/30 bg-red-500/10 text-red-300'
                    : tone === 'success'
                    ? 'border-green-500/30 bg-green-500/10 text-green-300'
                    : 'border-dark-border bg-dark-card/40 text-gray-200';

                statusEl.className = `mb-4 rounded-lg border px-4 py-3 text-sm ${toneClass}`;
                statusEl.textContent = message;
                statusEl.classList.remove('hidden');
              }

              function clearStatsPageStatus() {
                const statusEl = document.getElementById('stats-page-status');
                statusEl?.classList.add('hidden');
              }

              // Listen for auth state changes - this is the reliable way
              window.addEventListener('authStateChanged', (event) => {
                updateStatsVisibility(true);
                if (event.detail?.user) {
                  setStatsPageStatus('Syncing your latest progress...', 'info');
                }
                // Don't render stats yet - wait for cloud sync
              });

              // Listen for cloud sync complete - then render stats with fresh data
              window.addEventListener('cloudSyncComplete', (event) => {
                console.log('☁️ Cloud sync complete, rendering stats with fresh data');
                if (window.auth?.currentUser || window.currentUser) {
                  clearStatsPageStatus();
                  setTimeout(() => {
                    if (typeof renderStats === 'function') renderStats();
                  }, 100);
                }
              });

              // Fallback: if auth doesn't fire event within 2s, show appropriate screen
              setTimeout(() => {
                updateStatsVisibility(true);
                // If still no cloudSyncComplete after 3s, render with local data as fallback
                setTimeout(() => {
                  if (window.auth?.currentUser || window.currentUser) {
                    console.log('⚠️ Cloud sync timeout, rendering with local data');
                    setStatsPageStatus('Using local data. Cloud sync is taking longer than expected.', 'info');
                    if (typeof renderStats === 'function') renderStats();
                  }
                }, 1000);
              }, 2000);

              // Also update visibility on direct onAuthStateChanged
              if (window.auth) {
                import('https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js').then(({ onAuthStateChanged }) => {
                  onAuthStateChanged(window.auth, (user) => {
                    updateStatsVisibility(true);
                    // Don't render stats here - wait for cloudSyncComplete event
                  });
                }).catch(() => { });
              }

              const categorySelect = document.getElementById("category-section-select");
              const sectionSelectClasses =
                "w-full px-2 py-1 text-xs bg-dark-card text-gray-200 border border-dark-border rounded focus:outline-none focus:ring-2 focus:ring-blue-500";
              const selectHome = categorySelect
                ? {
                  parent: categorySelect.parentNode,
                  nextSibling: categorySelect.nextSibling,
                }
                : null;

              /**
               * Update language flag and name in stats header
               */
              function updateStatsLanguageDisplay() {
                const currentLang = localStorage.getItem("selectedLanguage") || "es";
                const flagElement = document.getElementById("stats-lang-flag");
                const nameElement = document.getElementById("stats-lang-name");

                const languageData = {
                  es: {
                    name: "Spanish",
                    flag: '<svg viewBox="0 0 32 32" class="w-full h-full"><rect y="0" x="0" height="32" width="32" fill="#c60b1e"/><rect y="11" x="0" height="10" width="32" fill="#ffc400"/></svg>',
                  },
                  de: {
                    name: "German",
                    flag: '<svg viewBox="0 0 32 32" class="w-full h-full"><rect y="0" x="0" height="11" width="32" fill="#000000"/><rect y="11" x="0" height="11" width="32" fill="#dd0000"/><rect y="22" x="0" height="10" width="32" fill="#ffce00"/></svg>',
                  },
                  fr: {
                    name: "French",
                    flag: '<svg viewBox="0 0 32 32" class="w-full h-full"><rect y="0" x="0" height="32" width="11" fill="#002395"/><rect y="0" x="11" height="32" width="11" fill="#ffffff"/><rect y="0" x="22" height="32" width="10" fill="#ed2939"/></svg>',
                  },
                  ru: {
                    name: "Russian",
                    flag: '<svg viewBox="0 0 32 32" class="w-full h-full"><rect y="0" x="0" height="11" width="32" fill="#ffffff"/><rect y="11" x="0" height="11" width="32" fill="#0039a6"/><rect y="22" x="0" height="10" width="32" fill="#d52b1e"/></svg>',
                  },
                  zh: {
                    name: "Chinese",
                    flag: '<svg viewBox="0 0 32 32" class="w-full h-full"><rect fill="#de2910" height="32" width="32" y="0" x="0"/><polygon fill="#ffde00" points="8,6 9.5,10 14,10 10.5,12.5 12,17 8,14 4,17 5.5,12.5 2,10 6.5,10"/></svg>',
                  },
                  ja: {
                    name: "Japanese",
                    flag: '<svg viewBox="0 0 32 32" class="w-full h-full"><rect fill="#ffffff" height="32" width="32" y="0" x="0"/><circle fill="#bc002d" cx="16" cy="16" r="6"/></svg>',
                  },
                  ko: {
                    name: "Korean",
                    flag: '<svg viewBox="0 0 32 32" class="w-full h-full"><rect fill="#ffffff" height="32" width="32" y="0" x="0"/><circle fill="none" stroke="#c60c30" stroke-width="2" cx="16" cy="16" r="6"/><path fill="#003478" d="M 16 10 A 6 6 0 0 1 16 22 Z"/><path fill="#c60c30" d="M 16 10 A 6 6 0 0 0 16 22 Z"/></svg>',
                  },
                  it: {
                    name: "Italian",
                    flag: '<svg viewBox="0 0 32 32" class="w-full h-full"><rect y="0" x="0" height="32" width="11" fill="#009246"/><rect y="0" x="11" height="32" width="10" fill="#eeeeee"/><rect y="0" x="21" height="32" width="11" fill="#ce2b36"/></svg>',
                  },
                };

                const langInfo = languageData[currentLang] || languageData.es;

                if (flagElement) {
                  flagElement.innerHTML = langInfo.flag;
                }
                if (nameElement) {
                  nameElement.textContent = `(${langInfo.name})`;
                }
              }

              // Update language display on page load
              updateStatsLanguageDisplay();

              // Listen for language changes
              window.addEventListener("languageChanged", updateStatsLanguageDisplay);

              const getCurrentLanguage = () =>
                localStorage.getItem("selectedLanguage") || "es";

              function restoreSectionSelect() {
                if (!categorySelect || !selectHome?.parent) return;
                categorySelect.className = sectionSelectClasses;
                if (
                  selectHome.nextSibling &&
                  selectHome.nextSibling.parentNode === selectHome.parent
                ) {
                  selectHome.parent.insertBefore(
                    categorySelect,
                    selectHome.nextSibling
                  );
                } else {
                  selectHome.parent.appendChild(categorySelect);
                }
              }

              function moveSectionSelectTo(container) {
                if (!categorySelect) return;
                if (container) {
                  categorySelect.className = sectionSelectClasses;
                  container.appendChild(categorySelect);
                } else {
                  restoreSectionSelect();
                }
              }

              const sectionSelectMediaQuery = window.matchMedia("(max-width: 640px)");

              function updateSectionSelectPlacement() {
                const selectorContainer = document.getElementById(
                  "category-selector-container"
                );
                if (!categorySelect) return;
                if (sectionSelectMediaQuery.matches) {
                  restoreSectionSelect();
                } else {
                  moveSectionSelectTo(selectorContainer);
                }
              }

              sectionSelectMediaQuery.addEventListener(
                "change",
                updateSectionSelectPlacement
              );

              function loadCompletionDatesSnapshot() {
                try {
                  return (
                    JSON.parse(
                      localStorage.getItem(
                        `categoryCompletionDates_${getCurrentLanguage()}`
                      ) || "{}"
                    ) || {}
                  );
                } catch (error) {
                  console.error("Error reading completion dates", error);
                  return {};
                }
              }

              /**
               * Main function to render statistics page
               * Loads user progress, calculates category stats, and renders tables
               */
              function renderStats() {
                if (!window.AppState || !window.DataService) {
                  setStatsPageStatus('Loading statistics engine...', 'info');
                  setTimeout(renderStats, 300);
                  return;
                }

                // CRITICAL: Verify localStorage data belongs to current user
                const storedUserId = localStorage.getItem("mc_current_user_id");
                const currentUserId = window.auth?.currentUser?.uid || window.currentUser?.uid;

                if (!currentUserId) {
                  console.warn("⚠️ No current user, cannot render stats");
                  setStatsPageStatus('Sign in to load your personal statistics.', 'error');
                  return;
                }

                if (storedUserId && storedUserId !== currentUserId) {
                  console.warn("⚠️ localStorage data belongs to different user, clearing and reloading...");
                  setStatsPageStatus('Refreshing data for your account...', 'info');
                  // Clear old data and wait for cloud sync
                  if (window.syncService?.clearLocalUserData) {
                    window.syncService.clearLocalUserData();
                  }
                  localStorage.setItem("mc_current_user_id", currentUserId);
                  // Wait for fresh data from cloud
                  setTimeout(renderStats, 500);
                  return;
                }

                const buttonStates = window.AppState.buttonStates || {};
                const userIsPremium = window.isPremiumUser || false;
                const allWords = window.DataService.allWords || [];

                // Fixed clicks to complete - always 5 for fair and consistent tracking
                const userClicksToComplete = 5;

                const categorySections = [
                  {
                    title: "Greetings & Introductions",
                    source: "free",
                    isPremium: false,
                  },
                  {
                    title: "Numbers & Time",
                    source: "premium1",
                    isPremium: true,
                  },
                  { title: "Food & Dining", source: "premium2", isPremium: true },
                  { title: "Travel & Tourism", source: "premium3", isPremium: true },
                  {
                    title: "Daily Life & Shopping",
                    source: "premium4",
                    isPremium: true,
                  },
                  {
                    title: "Family & Relationships",
                    source: "premium5",
                    isPremium: true,
                  },
                  { title: "Health & Body", source: "premium6", isPremium: true },
                  { title: "Education & Work", source: "premium7", isPremium: true },
                  { title: "Hobbies & Interests", source: "premium8", isPremium: true },
                ];

                const categoryStats = {};
                categorySections.forEach((section) => {
                  categoryStats[section.source] = {
                    title: section.title,
                    isPremium: section.isPremium,
                    categories: {},
                  };
                });

                /**
                 * Initialize the section selector dropdown
                 */
                function initSectionSelector() {
                  const select = document.getElementById("category-section-select");
                  if (!select) return;

                  // Clear existing options except the first one
                  select.innerHTML =
                    "<option disabled selected>Choose a section...</option>";

                  // Add sections to dropdown
                  categorySections.forEach((section, index) => {
                    const option = document.createElement("option");
                    option.value = section.source;
                    option.textContent = section.title;

                    // Add premium indicator and disable if user is not premium
                    if (section.isPremium) {
                      if (!userIsPremium) {
                        option.textContent += " [LOCKED]";
                        option.disabled = true;
                        option.className = "text-gray-400";
                      } else {
                        option.textContent += " [PREMIUM]";
                      }
                    }

                    select.appendChild(option);
                  });

                  // Add event listener for section selection (replace instead of stacking listeners)
                  select.onchange = function () {
                    const selectedSource = this.value;
                    const selectedSection = categorySections.find(
                      (s) => s.source === selectedSource
                    );
                    if (selectedSection) {
                      renderSelectedSection(selectedSection);
                    }
                  };

                  // Auto-select first available section
                  const firstAvailableSection = categorySections.find(
                    (s) => !s.isPremium || userIsPremium
                  );
                  if (firstAvailableSection) {
                    select.value = firstAvailableSection.source;
                    renderSelectedSection(firstAvailableSection);
                  }
                }

                /**
                 * Fill totalWords count for each category from DataService
                 */
                function fillTotalWords() {
                  categorySections.forEach((section) => {
                    const wordsInSection = allWords.filter(
                      (word) => word.source === section.source
                    );
                    wordsInSection.forEach((word) => {
                      const cat = word.category || "Unknown";
                      if (!categoryStats[section.source].categories[cat]) {
                        categoryStats[section.source].categories[cat] = {
                          total: 0,
                          locked: 0,
                          totalWords: 0,
                          lastLockedDate: null,
                        };
                      }
                      categoryStats[section.source].categories[cat].totalWords += 1;
                    });
                  });
                }

                /**
                 * Process user progress and update category completion tracking
                 * Optimized single-pass algorithm to reduce computation
                 */
                function fillUserProgress() {
                  // Initialize completion dates storage
                  let savedCompletionDates = {};
                  try {
                    const currentLang = getCurrentLanguage();
                    savedCompletionDates = JSON.parse(
                      localStorage.getItem(
                        `categoryCompletionDates_${currentLang}`
                      ) || "{}"
                    );
                  } catch (e) {
                    console.error("Error loading saved completion dates", e);
                  }

                  let datesUpdated = false;
                  const categoryProgress = {};

                  // Single pass - collect data and update stats
                  Object.values(buttonStates).forEach((state) => {
                    if (!state || !state.category) return;
                    const source = state.source || "free";
                    const cat = state.category;
                    const key = `${source}::${cat}`;

                    // Initialize progress tracking
                    if (!categoryProgress[key]) {
                      categoryProgress[key] = { total: 0, locked: 0, inProgress: 0, totalClicks: 0 };
                    }

                    // Initialize category stats
                    if (!categoryStats[source]) return;
                    if (!categoryStats[source].categories[cat]) {
                      categoryStats[source].categories[cat] = {
                        total: 0,
                        locked: 0,
                        inProgress: 0,
                        totalWords: 0,
                        lastLockedDate: null,
                        totalClicks: 0,
                      };
                    }

                    // Count ANY click progress (count > 0, even if not locked)
                    const hasBeenStarted =
                      state.count > 0 ||
                      (Array.isArray(state.clicks) && state.clicks.length > 0) ||
                      state.locked;

                    // Always count total for progress calculation
                    categoryProgress[key].total += 1;

                    if (state.locked) {
                      categoryProgress[key].locked += 1;
                      // Cap clicks contribution to user's clicksToComplete setting to avoid progress > 100%
                      categoryProgress[key].totalClicks += Math.min(state.count || 0, userClicksToComplete);
                    } else if (hasBeenStarted) {
                      // Count in-progress (started but not locked)
                      categoryProgress[key].inProgress += 1;
                      // Cap clicks contribution to user's clicksToComplete setting to avoid progress > 100%
                      categoryProgress[key].totalClicks += Math.min(state.count || 0, userClicksToComplete);
                    }

                    if (state.locked) {
                      // Check for category completion
                      const lastClick =
                        Array.isArray(state.clicks) && state.clicks.length > 0
                          ? state.clicks[state.clicks.length - 1].timestamp
                          : null;

                      // Check if this is a fully completed category
                      const totalWordsInCategory =
                        categoryStats[source].categories[cat].totalWords || 0;
                      const isFullyComplete =
                        totalWordsInCategory > 0 &&
                        categoryProgress[key].locked === totalWordsInCategory;

                      // Only update lastLockedDate and saved dates for fully completed categories
                      if (isFullyComplete && lastClick) {
                        // Only update if this is the latest timestamp for category completion
                        if (
                          !categoryStats[source].categories[cat].lastLockedDate ||
                          lastClick >
                          categoryStats[source].categories[cat].lastLockedDate
                        ) {
                          categoryStats[source].categories[cat].lastLockedDate =
                            lastClick;

                          // IMPORTANT: Don't overwrite challenge data objects with timestamp!
                          // Only set timestamp if there's no existing challenge data
                          const existingData = savedCompletionDates[key];
                          if (!existingData || typeof existingData !== 'object' || !('totalBonusPoints' in existingData)) {
                            savedCompletionDates[key] = lastClick;
                            datesUpdated = true;
                          }
                          delete savedCompletionDates[`${key}:inProgress`];
                        }
                      }
                    }
                  });

                  // Update final stats and check for in-progress categories
                  Object.keys(categoryProgress).forEach((key) => {
                    const [source, cat] = key.split("::");
                    if (
                      categoryStats[source] &&
                      categoryStats[source].categories[cat]
                    ) {
                      categoryStats[source].categories[cat].total =
                        categoryProgress[key].total;
                      categoryStats[source].categories[cat].locked =
                        categoryProgress[key].locked;
                      categoryStats[source].categories[cat].inProgress =
                        categoryProgress[key].inProgress;
                      categoryStats[source].categories[cat].totalClicks =
                        categoryProgress[key].totalClicks;

                      // Check if category is in progress but not complete
                      const totalWordsInCategory =
                        categoryStats[source].categories[cat].totalWords || 0;
                      if (
                        categoryProgress[key].locked > 0 &&
                        categoryProgress[key].locked < totalWordsInCategory
                      ) {
                        savedCompletionDates[`${key}:inProgress`] = true;
                        datesUpdated = true;
                      }
                    }
                  });

                  // Save updated completion dates back to localStorage if anything changed
                  if (datesUpdated) {
                    try {
                      const currentLang = getCurrentLanguage();
                      localStorage.setItem(
                        `categoryCompletionDates_${currentLang}`,
                        JSON.stringify(savedCompletionDates)
                      );
                    } catch (e) {
                      console.error("Error saving completion dates", e);
                    }
                  }
                }

                /**
                 * Fill All Languages Progress table with stats from all languages
                 * CRITICAL: Only show data if it belongs to the current user
                 */
                function fillAllLanguagesProgress() {
                  const LANGUAGES = ['es', 'de', 'fr', 'ru', 'zh', 'ja', 'ko', 'it'];

                  // Verify data ownership
                  const storedUserId = localStorage.getItem("mc_current_user_id");
                  const currentUserId = window.auth?.currentUser?.uid || window.currentUser?.uid;

                  if (!currentUserId || (storedUserId && storedUserId !== currentUserId)) {
                    console.warn("⚠️ fillAllLanguagesProgress: Data doesn't belong to current user, showing zeros");
                    LANGUAGES.forEach((lang) => {
                      const starsEl = document.getElementById(`all-stars-${lang}`);
                      const challengesEl = document.getElementById(`all-challenges-${lang}`);
                      if (starsEl) starsEl.textContent = 0;
                      if (challengesEl) challengesEl.textContent = 0;
                    });
                    return;
                  }

                  LANGUAGES.forEach((lang) => {
                    const repeatCounts = JSON.parse(
                      localStorage.getItem(`repeatCounts_${lang}`) || "{}"
                    );
                    const completionMap = JSON.parse(
                      localStorage.getItem(`categoryCompletionDates_${lang}`) || "{}"
                    );

                    // Count stars (category completions)
                    const langStars = Object.values(repeatCounts).reduce(
                      (sum, count) => sum + (count || 0), 0
                    );

                    // Count challenge completions
                    const completionEntries = Object.values(completionMap).filter(
                      (entry) => entry && typeof entry === "object" && "totalBonusPoints" in entry
                    );
                    const langChallenges = completionEntries.length;

                    // Update DOM elements
                    const starsEl = document.getElementById(`all-stars-${lang}`);
                    const challengesEl = document.getElementById(`all-challenges-${lang}`);

                    if (starsEl) starsEl.textContent = langStars;
                    if (challengesEl) challengesEl.textContent = langChallenges;
                  });
                }

                /**
                 * Render a single selected section instead of all sections
                 */
                function renderSelectedSection(section) {
                  const statsContainer = document.getElementById("stats-container");
                  if (!statsContainer) return;

                  const completionDates = loadCompletionDatesSnapshot();

                  // Clear previous content
                  const starPathD =
                    "M11.48 3.499a.562.562 0 011.04 0l1.132 3.486a.563.563 0 00.53.39l3.662.053c.499.007.705.64.305.94l-2.965 2.215a.563.563 0 00-.198.59l.93 3.457c.123.457-.388.82-.79.593L12 13.875l-3.126 1.848c-.403.227-.914-.136-.79-.593l.93-3.457a.563.563 0 00-.198-.59L5.85 8.368c-.4-.3-.194-.933.305-.94l3.662-.053a.563.563 0 00.53-.39l1.132-3.486z";

                  const renderStarIcons = (filledCount = 0, totalStars = 2) => {
                    const stars = [];
                    for (let i = 0; i < totalStars; i++) {
                      const isFilled = i < filledCount;
                      if (isFilled) {
                        stars.push(`
                                <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                  <path d="${starPathD}"></path>
                                </svg>
                              `);
                      } else {
                        stars.push(`
                                <svg class="w-3.5 h-3.5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                  <path d="${starPathD}" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                              `);
                      }
                    }
                    return `<span class="flex items-center gap-0.5">${stars.join("")}</span>`;
                  };

                  const renderLegendStars = (count = 1) => {
                    const filledStar = `
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: #FF8C02;">
                              <path d="${starPathD}"></path>
                            </svg>
                          `;
                    return `<span class="flex items-center gap-0.5">${filledStar.repeat(count)}</span>`;
                  };

                  const renderLevelBadge = (repeatCount = 0) => {
                    // Simple 5-star system: each category completion fills one star
                    const totalStars = 5;
                    const filledStars = Math.min(repeatCount, totalStars);
                    const extraRepeats = repeatCount > 5 ? repeatCount - 5 : 0;

                    const starPathD = "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z";

                    let starsHtml = '';
                    for (let i = 0; i < totalStars; i++) {
                      if (i < filledStars) {
                        // Filled gold star
                        starsHtml += `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="#FFD700" aria-hidden="true"><path d="${starPathD}"></path></svg>`;
                      } else {
                        // Empty star (just outline)
                        starsHtml += `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.5" aria-hidden="true"><path d="${starPathD}"></path></svg>`;
                      }
                    }

                    // Show extra repeats counter if more than 5
                    const extraHtml = extraRepeats > 0 ? `<span class="text-xs text-gray-400 ml-1">(+${extraRepeats})</span>` : '';

                    return `<span class="flex items-center gap-0.5">${starsHtml}${extraHtml}</span>`;
                  };

                  statsContainer.innerHTML = "";

                  const sectionData = categoryStats[section.source];
                  const categories = Object.keys(sectionData.categories);
                  const inferredGroupSize =
                    window.AppState?.cardsData?.[0]?.words?.length || 4;

                  const getCategoryCardProgress = (categoryName) => {
                    const categoryWords = allWords.filter(
                      (word) =>
                        word.source === section.source &&
                        word.category === categoryName
                    );

                    if (categoryWords.length === 0) {
                      return { totalCards: 0, completedCards: 0, startedCards: 0 };
                    }

                    const totalCards = Math.ceil(
                      categoryWords.length / inferredGroupSize
                    );
                    let completedCards = 0;
                    let startedCards = 0;

                    for (let i = 0; i < categoryWords.length; i += inferredGroupSize) {
                      const cardWords = categoryWords.slice(i, i + inferredGroupSize);
                      let lockedCount = 0;
