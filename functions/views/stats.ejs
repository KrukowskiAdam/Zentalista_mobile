 sep.className = "h-px bg-learning-app-design-3";
 optionsContainer.appendChild(sep);
 });

 // Remove last separator
 if (optionsContainer.lastChild) optionsContainer.removeChild(optionsContainer.lastChild);

 // Toggle dropdown — use onclick to avoid stacking on re-init
 trigger.onclick = (e) => {
