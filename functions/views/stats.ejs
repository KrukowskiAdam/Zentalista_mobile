 <style>
 #stats-container .px-2 {
 padding-left: 0.2rem;
 padding-right: 0.2rem;
 }

 #stats-container .stats-table {
 display: block;
 }

 #stats-container .stats-table thead {
 display: block;
 }

 #stats-container .stats-table thead tr {
 display: grid;
 grid-template-columns: 1fr 1fr 1fr;
 }

 #stats-container .stats-table tbody {
 display: block;
 }

 #stats-container .stats-table tbody tr {
 display: grid;
 grid-template-columns: 1fr 1fr 1fr;
 grid-template-rows: auto auto;
 padding: 0.875rem 1rem;
 gap: 0 1.5rem;
 }

 #stats-container .stats-table tbody tr:last-child {
 margin-bottom: 0;
 border-bottom: none;
 }

 #stats-all-languages tbody tr:last-child {
 border-bottom: none;
 }

 #stats-container .stats-table tbody th {
 grid-column: 1 / -1;
 display: block;
 padding: 0 0 1rem 0;
 text-align: left;
 white-space: normal;
 font-weight: 400;
 color: #e5e7eb;
 }

 #stats-container .stats-table tbody td {
 display: block;
 padding: 0.375rem 0;
 text-align: left;
 white-space: normal;
 }
 </style>

 <div class="container mx-auto px-4 pt-4 max-w-6xl safe-bottom">
 <!-- Loading spinner while checking auth -->
 <div id="auth-loading" class="text-center py-16 space-y-4">
