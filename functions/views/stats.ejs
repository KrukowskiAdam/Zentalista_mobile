                <div class="flex items-center gap-1">
                  <svg class="w-3 h-3 text-level-expert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 3L14 9L10 5L3 11M4.5 21C3.67157 21 3 20.3284 3 19.5V17.5C3 16.6716 3.67157 16 4.5 16C5.32843 16 6 16.6716 6 17.5V19.5C6 20.3284 5.32843 21 4.5 21ZM11.5 21C10.6716 21 10 20.3284 10 19.5V14.5C10 13.6716 10.6716 13 11.5 13C12.3284 13 13 13.6716 13 14.5V19.5C13 20.3284 12.3284 21 11.5 21ZM18.5 21C17.6716 21 17 20.3284 17 19.5V16.5C17 15.6716 17.6716 15 18.5 15C19.3284 15 20 15.6716 20 16.5V19.5C20 20.3284 19.3284 21 18.5 21Z"/>
                  </svg>
                  <span>Progress</span>
                </div>
              </th>
              <th scope="col" class="px-4 py-3" style="width: 120px;">
                <div class="flex items-center gap-1">
                  <svg class="w-3 h-3 text-yellow-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11.2691 4.41115C11.5006 3.89177 11.6164 3.63208 11.7776 3.55211C11.9176 3.48263 12.082 3.48263 12.222 3.55211C12.3832 3.63208 12.499 3.89177 12.7305 4.41115L14.5745 8.54808C14.643 8.70162 14.6772 8.77839 14.7302 8.83718C14.777 8.8892 14.8343 8.93081 14.8982 8.95929C14.9705 8.99149 15.0541 9.00031 15.2213 9.01795L19.7256 9.49336C20.2911 9.55304 20.5738 9.58288 20.6997 9.71147C20.809 9.82316 20.8598 9.97956 20.837 10.1342C20.8108 10.3122 20.5996 10.5025 20.1772 10.8832L16.8125 13.9154C16.6877 14.0279 16.6252 14.0842 16.5857 14.1527C16.5507 14.2134 16.5288 14.2807 16.5215 14.3503C16.5132 14.429 16.5306 14.5112 16.5655 14.6757L17.5053 19.1064C17.6233 19.6627 17.6823 19.9408 17.5989 20.1002C17.5264 20.2388 17.3934 20.3354 17.2393 20.3615C17.0619 20.3915 16.8156 20.2495 16.323 19.9654L12.3995 17.7024C12.2539 17.6184 12.1811 17.5765 12.1037 17.56C12.0352 17.5455 11.9644 17.5455 11.8959 17.56C11.8185 17.5765 11.7457 17.6184 11.6001 17.7024L7.67662 19.9654C7.18404 20.2495 6.93775 20.3915 6.76034 20.3615C6.60623 20.3354 6.47319 20.2388 6.40075 20.1002C6.31736 19.9408 6.37635 19.6627 6.49434 19.1064L7.4341 14.6757C7.46898 14.5112 7.48642 14.429 7.47814 14.3503C7.47081 14.2807 7.44894 14.2134 7.41394 14.1527C7.37439 14.0842 7.31195 14.0279 7.18708 13.9154L3.82246 10.8832C3.40005 10.5025 3.18884 10.3122 3.16258 10.1342C3.13978 9.97956 3.19059 9.82316 3.29993 9.71147C3.42581 9.58288 3.70856 9.55304 4.27406 9.49336L8.77835 9.01795C8.94553 9.00031 9.02911 8.99149 9.10139 8.95929C9.16534 8.93081 9.2226 8.8892 9.26946 8.83718C9.32241 8.77839 9.35663 8.70162 9.42508 8.54808L11.2691 4.41115Z"/>
                  </svg>
                  <span>Stars</span>
                </div>
              </th>
              <th scope="col" class="px-4 py-3" style="width: 160px;">
                <div class="flex items-center gap-1">
                  <svg class="w-3 h-3 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 7V12L9.5 13.5M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z"/>
                  </svg>
                  <span>When to Review</span>
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            ${categories
                        .map((categoryName) => {
                          const stats = sectionData.categories[categoryName];
                          const key = `${section.source}::${categoryName}`;
                          const repeatCount = window.AppState.repeatCounts
                            ? window.AppState.repeatCounts[key] || 0
                            : 0;
                          const isCurrentlyComplete =
                            stats.locked === stats.totalWords && stats.totalWords > 0;

                          const { totalCards, completedCards, startedCards } =
                            getCategoryCardProgress(categoryName);

                          // Calculate progress based on completed cards (not clicks)
                          const progressPercentage = totalCards > 0
                            ? Math.round((completedCards / totalCards) * 100)
                            : 0;

                          // Get the saved completion date from localStorage directly
                          const completionEntry = completionDates[key];
                          let completionDate = null;

                          if (typeof completionEntry === "number") {
                            completionDate = completionEntry;
                          } else if (typeof completionEntry === "string") {
                            const parsed = Date.parse(completionEntry);
                            completionDate = Number.isFinite(parsed) ? parsed : null;
                          } else if (completionEntry && typeof completionEntry === "object") {
                            // Challenge data object - use completion timestamp if available
                            if (completionEntry.lastLockedDate) {
                              completionDate = completionEntry.lastLockedDate;
                            } else if (completionEntry.completedAt) {
                              const parsed = Date.parse(completionEntry.completedAt);
                              completionDate = Number.isFinite(parsed) ? parsed : null;
                            }
                          }

                          if (!completionDate && stats.lastLockedDate) {
                            completionDate = stats.lastLockedDate;
                          }

                          if (completionDate && typeof completionDate !== "number") {
                            const parsed = Date.parse(completionDate);
                            completionDate = Number.isFinite(parsed) ? parsed : null;
                          }

                          // Fixed 24-hour cooldown (in milliseconds)
                          const COOLDOWN_HOURS = 24;
                          const COOLDOWN_MS = COOLDOWN_HOURS * 60 * 60 * 1000;

                          // Show relative time and countdown to next review
                          let lastLockedDate = "Never";
                          let nextReviewText = "";
                          let nextReviewBadgeClass = "bg-gray-100 text-gray-600";
                          let isReviewReady = false;

                          if (completionDate) {
                            // TEST MODE: Add ?testHours=X to URL to simulate X hours passing
                            const urlParams = new URLSearchParams(window.location.search);
                            const testHours = parseInt(urlParams.get('testHours')) || 0;
                            const now = Date.now() + (testHours * 60 * 60 * 1000);

                            const timeDiff = now - completionDate;
                            const hoursDiff = Math.floor(timeDiff / (1000 * 60 * 60));
                            const minutesDiff = Math.floor(timeDiff / (1000 * 60));

                            // Format "last completed" text
                            if (hoursDiff >= 24) {
                              const daysDiff = Math.floor(hoursDiff / 24);
                              lastLockedDate = daysDiff === 1 ? "1 day ago" : `${daysDiff} days ago`;
                            } else if (hoursDiff > 0) {
                              lastLockedDate = hoursDiff === 1 ? "1 hour ago" : `${hoursDiff} hours ago`;
                            } else if (minutesDiff > 0) {
                              lastLockedDate = minutesDiff === 1 ? "1 minute ago" : `${minutesDiff} minutes ago`;
                            } else {
                              lastLockedDate = "Just now";
                            }

                            // Calculate hours until next review (24h cooldown)
                            const hoursUntilReview = COOLDOWN_HOURS - hoursDiff;

                            if (hoursUntilReview > 0) {
                              // Still in cooldown - show hours remaining
                              nextReviewText = `Review in ${hoursUntilReview}h`;
                              nextReviewBadgeClass = "text-xs text-gray-400";
                              isReviewReady = false;
                            } else {
                              // Cooldown complete - ready to review!
                              nextReviewText = `Review now`;
                              nextReviewBadgeClass = "text-xs text-green-600";
                              isReviewReady = true;
                            }
                          }

                          return `
                <tr class="border-b border-dark-border hover:bg-dark-bg">
                  <th scope="row" class="px-4 py-4 font-medium text-gray-200 whitespace-nowrap">${categoryName}</th>
                  <td class="px-4 py-4" data-label="Progress">
                    <div class="flex flex-col gap-1">
                      <span class="text-gray-300 font-medium" style="font-size: .75rem; line-height: 1rem;">${progressPercentage}%</span>
                      <div class="w-full bg-dark-bg rounded-full" style="height: .375rem;">
                        <div class="rounded-full transition-all duration-300" style="width: ${progressPercentage}%; background-color: #05C7F2; height: .375rem;"></div>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-4" data-label="Levels">
                    ${renderLevelBadge(repeatCount)}
                  </td>
                  <td class="px-4 py-4" data-label="When to review">
                    ${(() => {
                              // Category is NOT complete (progress < 100%)
                              // Show Continue or Start based on whether user has started
                              if (progressPercentage < 100) {
                                if (startedCards > 0) {
                                  return `<button class="continue-btn btn btn-outline text-xs" style="padding: 0.125rem 0.75rem; min-height: auto; height: auto; width: 100px;" data-source="${section.source}" data-category="${categoryName}">Continue</button>`;
                                }
                                return `<button class="start-btn btn btn-outline text-xs" style="padding: 0.125rem 0.75rem; min-height: auto; height: auto; width: 100px;" data-source="${section.source}" data-category="${categoryName}">Start</button>`;
                              }

                              // Category is 100% complete
                              // Check if cooldown has passed
                              if (completionDate) {
                                return isReviewReady
                                  ? `<button class="restart-btn btn btn-outline btn-success text-xs" style="padding: 0.125rem 0.75rem; min-height: auto; height: auto; width: 100px;" data-source="${section.source}" data-category="${categoryName}">Review Now</button>`
                                  : `<span class="${nextReviewBadgeClass}">${nextReviewText}</span>`;
                              }

                              // 100% complete but no completion date (edge case - shouldn't happen)
                              return `<button class="restart-btn btn btn-outline btn-success text-xs" style="padding: 0.125rem 0.75rem; min-height: auto; height: auto; width: 100px;" data-source="${section.source}" data-category="${categoryName}">Review Now</button>`;
                            })()}
                  </td>
                </tr>
              `;
                        })
                        .join("")}
          </tbody>
        `;

                    tableContainer.appendChild(table);
                    tableWrapper.appendChild(tableContainer);

                    // Append table to inner container
                    innerContainer.appendChild(tableWrapper);

                    // Append inner container to outer wrapper
                    outerWrapper.appendChild(innerContainer);

                    // Append complete structure to stats container
                    statsContainer.appendChild(outerWrapper);

                  } else if (sectionData.isPremium) {
                    if (userIsPremium) {
                      const noDataDiv = document.createElement("div");
                      noDataDiv.className = "alert alert-info alert-sm";
                      noDataDiv.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-sm">No data yet - start learning to see your progress!</span>
          `;
                      statsContainer.appendChild(noDataDiv);
                    } else {
                      const premiumAlert = document.createElement("div");
                      premiumAlert.className = "alert alert-warning alert-sm";
                      premiumAlert.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z"></path></svg>
            <div>
              <h3 class="font-bold text-sm">Premium Content</h3>
              <div class="text-xs">[LOCKED] Unlock premium to access these categories and track your progress!</div>
            </div>
          `;

                      const upgradeButton = document.createElement("button");
                      upgradeButton.className = "btn btn-warning btn-xs mt-2";
                      upgradeButton.innerHTML = "Upgrade to Premium";
                      upgradeButton.onclick = () => {
                        window.location.href = "/premium";
                      };

                      premiumAlert.appendChild(upgradeButton);
                      statsContainer.appendChild(premiumAlert);
                    }
                  }

                  // Setup event handlers for this section
                  setupRestartHandlers();

                  // Ensure the section selector is always reachable
                  updateSectionSelectPlacement();
                }

                // Helper function to update localStorage safely
                // IMPORTANT: Preserves challenge data objects, only updates simple timestamps
                function updateLocalStorage(updates) {
                  try {
                    const currentLang = getCurrentLanguage();
                    const savedDates = JSON.parse(
                      localStorage.getItem(
                        `categoryCompletionDates_${currentLang}`
                      ) || "{}"
                    );

                    // Don't overwrite challenge data objects with simple timestamps
                    Object.entries(updates).forEach(([key, value]) => {
                      const existing = savedDates[key];
                      // If existing data is a challenge object (has totalBonusPoints), don't overwrite with timestamp
                      if (existing && typeof existing === 'object' && 'totalBonusPoints' in existing) {
                        // Only allow resetting metadata keys like :reset, :inProgress
                        if (!key.includes(':')) {
                          return; // Skip - don't overwrite challenge data
                        }
                      }
                      savedDates[key] = value;
                    });

                    localStorage.setItem(
                      `categoryCompletionDates_${currentLang}`,
                      JSON.stringify(savedDates)
                    );
                  } catch (e) {
                    console.error("Error updating localStorage:", e);
                  }
                }

                // Logika obsługi przycisków w kolumnie Actions
                function setupRestartHandlers() {
                  // Handle "Repeat" buttons - reset category and navigate
                  document.querySelectorAll(".restart-btn").forEach((btn) => {
                    btn.onclick = function () {
                      const source = btn.getAttribute("data-source");
                      const category = btn.getAttribute("data-category");
                      const key = `${source}::${category}`;

                      console.log('🔄 Review button clicked:', { source, category });

                      // Find the actual completion date to preserve it
                      let completionDate = null;
                      if (
                        categoryStats[source] &&
                        categoryStats[source].categories[category]
                      ) {
                        completionDate =
                          categoryStats[source].categories[category].lastLockedDate;
                      }

                      // Reset directly in localStorage
                      try {
                        const currentLang = getCurrentLanguage();
                        const buttonStatesKey = `buttonStates_${currentLang}`;
                        let buttonStates = JSON.parse(localStorage.getItem(buttonStatesKey) || '{}');

                        console.log('📦 Before reset:', Object.keys(buttonStates).length, 'buttons');

                        // Reset all buttons in this category
                        let resetCount = 0;
                        Object.entries(buttonStates).forEach(([key, state]) => {
                          if (state?.source === source && state?.category === category) {
                            state.locked = false;
                            state.count = 0;
                            state.clicks = [];
                            state.lastClicked = null;
                            state.wasReset = true;
                            state.resetTime = Date.now();
                            resetCount++;
                          }
                        });

                        console.log('✅ Reset', resetCount, 'buttons in category');

                        // Save back to localStorage
                        localStorage.setItem(buttonStatesKey, JSON.stringify(buttonStates));

                      } catch (error) {
                        console.error('❌ Error resetting category in localStorage:', error);
                      }

                      // Update localStorage with all needed changes
                      const updates = {
                        [`${key}:reset`]: Date.now(),
                      };

                      // Keep completion date for display if it exists
                      if (completionDate) {
                        updates[key] = completionDate;
                      }

                      updateLocalStorage(updates);

                      // Clear progress flags separately
                      try {
                        const currentLang = getCurrentLanguage();
                        const savedDates = JSON.parse(
                          localStorage.getItem(
                            `categoryCompletionDates_${currentLang}`
                          ) || "{}"
                        );
                        delete savedDates[`${key}:inProgress`];
                        localStorage.setItem(
                          `categoryCompletionDates_${currentLang}`,
                          JSON.stringify(savedDates)
                        );
                      } catch (e) {
                        console.error("Error clearing progress flags", e);
                      }

                      // Save target category to localStorage for learn page navigation
                      try {
                        localStorage.setItem(
                          "openCategory",
                          JSON.stringify({
                            source: source,
                            category: category,
                            timestamp: Date.now(),
                          })
                        );
                      } catch (e) {
                        console.error("Error saving target category", e);
                      }

                      // Force sync to cloud immediately after reset
                      if (window.syncService && typeof window.syncService.syncToCloud === 'function') {
                        console.log('☁️ Forcing sync to cloud after reset...');
                        window.syncService.syncToCloud().then(() => {
                          console.log('✅ Cloud sync complete');
                          // Redirect after sync completes
                          window.location.href = "/learn";
                        }).catch((err) => {
                          console.error('❌ Cloud sync failed:', err);
                          // Redirect anyway
                          window.location.href = "/learn";
                        });
                      } else {
                        console.log('🚀 Redirecting to /learn (no sync service)...');
                        // Redirect to learn page
                        window.location.href = "/learn";
                      }
                    };
                  });

                  // Handle "Continue" buttons - just navigate without reset
                  document.querySelectorAll(".continue-btn").forEach((btn) => {
                    btn.onclick = function () {
                      const source = btn.getAttribute("data-source");
                      const category = btn.getAttribute("data-category");

                      // Save target category to localStorage for learn page navigation
                      try {
                        localStorage.setItem(
                          "openCategory",
                          JSON.stringify({
                            source: source,
                            category: category,
                            timestamp: Date.now(),
                          })
                        );
                      } catch (e) {
                        console.error("Error saving target category", e);
                      }

                      // Redirect to learn page to continue learning
                      window.location.href = "/learn";
                    };
                  });

                  // Handle "Start" buttons - navigate to begin learning new category
                  document.querySelectorAll(".start-btn").forEach((btn) => {
                    btn.onclick = function () {
                      const source = btn.getAttribute("data-source");
                      const category = btn.getAttribute("data-category");

                      // Save target category to localStorage for learn page navigation
                      try {
                        localStorage.setItem(
                          "openCategory",
                          JSON.stringify({
                            source: source,
                            category: category,
                            timestamp: Date.now(),
                          })
                        );
                      } catch (e) {
                        console.error("Error saving target category", e);
                      }

                      // Redirect to learn page to start learning
                      window.location.href = "/learn";
                    };
                  });
                }

                fillTotalWords();
                fillUserProgress();

                // Fill All Languages Progress table
                fillAllLanguagesProgress();

                // Initialize the section selector and render the first available section
                initSectionSelector();

                const statsContainer = document.getElementById("stats-container");
                if (statsContainer.children.length === 0) {
                  const noDataDiv = document.createElement("div");
                  noDataDiv.className = "text-center py-8 border border-dashed border-dark-border rounded-lg bg-dark-card/30";
                  noDataDiv.innerHTML = `
        <p class="text-sm text-gray-300">No statistics yet.</p>
        <p class="text-xs text-gray-400 mt-1">Start learning categories to populate your progress overview.</p>
      `;
                  statsContainer.appendChild(noDataDiv);
                  setStatsPageStatus('No statistics data yet. Complete your first category to see progress here.', 'info');
                  return;
                }

                clearStatsPageStatus();
              }

              setTimeout(renderStats, 2000);

              setTimeout(() => {
                if (window.AppState) {
                  if (typeof window.AppState.on === "function") {
                    window.AppState.on("stateChanged", renderStats);
                  } else {
                    let previousStateJSON = JSON.stringify(
                      window.AppState.buttonStates || {}
                    );
                    const stateMonitor = setInterval(() => {
                      if (!window.AppState || !window.AppState.buttonStates) {
                        clearInterval(stateMonitor);
                        return;
                      }
                      const currentStateJSON = JSON.stringify(
                        window.AppState.buttonStates || {}
                      );
                      if (currentStateJSON !== previousStateJSON) {
                        previousStateJSON = currentStateJSON;
                        renderStats();
                      }
                    }, 2000);
                    window.addEventListener("beforeunload", () => {
                      clearInterval(stateMonitor);
                    });
                  }
                }
              }, 2500);
            });
          </script>
  </body>

</html>