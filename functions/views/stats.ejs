<!DOCTYPE html>
<html lang="en" data-theme="dark" style="background-color: #030712;">
<%- include('partials/head') %>

  <body class="m-0 p-0 bg-dark-bg text-gray-200" style="padding-top: 80px;">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5L47BNJP" height="0" width="0"
        style="display: none; visibility: hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Nawigacja główna -->
    <%- include('partials/menu') %>

      <style>
        #stats-container .legend-reviews-row {
          display: flex;
          align-items: center;
          gap: 0.5rem;
        }

        #stats-container .legend-reviews-badges {
          display: flex;
          flex-wrap: wrap;
          gap: 0.5rem;
          width: 100%;
        }

        #stats-container .legend-progress-note {
          padding-left: 1.5rem;
        }

        @media (max-width: 640px) {
          #stats-container .stats-table {
            display: block;
          }

          #stats-container .stats-table thead {
            display: none;
          }

          #stats-container .stats-table tbody {
            display: block;
          }

          #stats-container .stats-table tbody tr {
            display: block;
            border: 1px solid #1f2937;
            border-radius: 0.75rem;
            padding: 0.875rem 1rem;
            margin-bottom: 1rem;
            background-color: #0f172a;
          }

          #stats-container .stats-table tbody tr:last-child {
            margin-bottom: 0;
          }

          #stats-container .stats-table tbody th,
          #stats-container .stats-table tbody td {
            display: block;
            width: 100%;
            padding: 0.625rem 0;
            text-align: left;
            white-space: normal;
          }

          #stats-container .stats-table tbody [data-label]::before {
            content: attr(data-label);
            display: block;
            font-size: 0.7rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: #9ca3af;
            margin-bottom: 0.1rem;
          }

          #stats-container .legend-reviews-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
          }

          #stats-container .legend-reviews-badges {
            display: grid;
            grid-template-columns: 1fr;
          }

          #stats-container .legend-progress-note {
            padding-left: 0;
          }
        }
      </style>

      <div class="container mx-auto px-4 py-8 pt-12 max-w-6xl safe-bottom">
        <div id="stats-page-status" class="hidden mb-4"></div>

        <!-- Loading spinner while checking auth -->
        <div id="auth-loading" class="text-center py-16 space-y-4">
          <span class="loading loading-spinner loading-lg text-gray-500"></span>
          <p class="text-sm text-gray-400">Preparing your statistics and synced progress...</p>
        </div>

        <!-- Login required screen for non-logged-in users -->
        <div id="login-required-screen" class="hidden">
          <div class="text-center py-16">
            <div class="mb-6">
              <svg class="w-20 h-20 mx-auto text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-100 mb-3">Sign in to view your statistics</h2>
            <p class="text-gray-400 mb-6 max-w-md mx-auto">
              Track your learning progress, see category completion, and sync your stats across all your devices.
            </p>
            <label for="modal-login"
              class="btn touch-target bg-blue-600 hover:bg-blue-700 text-white border-none px-8 w-full sm:w-auto cursor-pointer">
              Sign In
            </label>
            <p class="text-gray-500 text-sm mt-4">
              Don't have an account?
              <label for="modal-signup" class="text-blue-400 hover:text-blue-300 cursor-pointer">Create one for
                free</label>
            </p>
          </div>
        </div>

        <!-- Stats content (shown only when logged in) -->
        <div id="stats-content" class="hidden">
          <!-- Header -->
          <div class="text-center mb-6 sm:mb-7 px-1">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-100 mb-2 flex items-center justify-center gap-2 sm:gap-3">
              <svg class="w-8 h-8 sm:w-10 sm:h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: #ff8c02;"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
              </svg>
              Learning Statistics
            </h1>
            <p class="text-gray-400 py-4 sm:py-8 max-w-2xl mx-auto">Track your learning progress and see category completion across all languages.
