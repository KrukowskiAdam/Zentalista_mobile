 };
 const lang = localStorage.getItem('selectedLanguage') || 'es';
 const langData = langMap[lang] || langMap.es;
 document.getElementById('current-flag').innerHTML = langData.flag;
 const currentLangCode = document.getElementById('current-lang-code');
 if (currentLangCode) {
 currentLangCode.textContent = langData.code;
 }
 })();
