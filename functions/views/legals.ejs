<!DOCTYPE html>
<html lang="en" style="background-color: #030712;">
<%- include('partials/head') %>

  <body class="m-0 p-0 bg-dark-bg text-gray-200" style="padding-top: 80px;">
    <%- include('partials/menu') %>

      <main class="container mx-auto px-4 py-8 pt-12 max-w-4xl">
        <!-- Privacy Policy Section -->
        <section id="privacy-policy" class="mb-12 scroll-mt-20">
          <div class="max-w-4xl mx-auto p-8 rounded-lg shadow-md bg-dark-card border border-dark-border">
            <h2 class="text-3xl font-bold mb-2">Privacy Policy</h2>
            <p class="text-sm opacity-75 mb-6">Last updated: January 24, 2026</p>

            <div class="space-y-6">
              <div>
                <h3 class="text-xl font-semibold mb-3">Data Controller</h3>
                <p class="pl-4">Adam Krukowski<br>
                  Contact: <a href="mailto:contact@zentalist.com"
                    class="text-level-expert hover:underline">contact@zentalist.com</a></p>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Collected Data</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2"><strong>Account data:</strong> Email address, display name (when you create an
                    account)</li>
                  <li class="mb-2"><strong>Payment data:</strong> Processed by third-party payment providers depending on platform: Stripe for web checkout, and Apple App Store / Google Play for in-app purchases (managed via RevenueCat). We do not store full credit card numbers</li>
                  <li class="mb-2"><strong>Usage data:</strong> Learning progress, completed categories, challenge
                    scores (stored locally in your browser)</li>
                  <li><strong>Technical data:</strong> IP address, browser type, device info (for analytics and
                    security)</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Purpose of Processing</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2">To provide access to the Zentalist learning platform</li>
                  <li class="mb-2">To process payments and manage subscriptions</li>
                  <li class="mb-2">To sync your learning progress across devices</li>
                  <li class="mb-2">To display your ranking on the Global Leaderboard</li>
                  <li>To respond to support inquiries</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Legal Basis (GDPR)</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2"><strong>Article 6(1)(b)</strong> - Contract execution (providing the service you
                    signed up for)</li>
                  <li class="mb-2"><strong>Article 6(1)(a)</strong> - Consent (for optional cookies and analytics)</li>
                  <li><strong>Article 6(1)(f)</strong> - Legitimate interest (security, fraud prevention)</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Data Recipients (Third Parties)</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2"><strong>Stripe</strong> - Payment processing for web checkout</li>
                  <li class="mb-2"><strong>Apple App Store / Google Play</strong> - Payment processing for in-app purchases</li>
                  <li class="mb-2"><strong>RevenueCat</strong> - Subscription infrastructure and entitlement synchronization for in-app purchases</li>
                  <li class="mb-2"><strong>Google Firebase</strong> - Authentication and database (USA, Standard
                    Contractual Clauses)</li>
                  <li><strong>Google Analytics</strong> - Anonymous usage statistics (optional, can be disabled)</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Data Retention</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2"><strong>Account data:</strong> Until you delete your account</li>
                  <li class="mb-2"><strong>Payment records:</strong> 5 years (Polish tax law requirement)</li>
                  <li><strong>Analytics data:</strong> 26 months (Google Analytics default)</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">Your Rights (GDPR)</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2">Right to access your personal data</li>
                  <li class="mb-2">Right to rectification (correct inaccurate data)</li>
                  <li class="mb-2">Right to erasure ("right to be forgotten")</li>
                  <li class="mb-2">Right to data portability</li>
                  <li class="mb-2">Right to object to processing</li>
                  <li>Right to lodge a complaint with UODO (Polish Data Protection Authority)</li>
                </ul>
                <p class="mt-4 pl-4">To exercise your rights: <a href="mailto:contact@zentalist.com"
                    class="text-level-expert hover:underline">contact@zentalist.com</a></p>
              </div>
            </div>
          </div>
        </section>

        <!-- Cookie Policy Section -->
        <section id="cookie-policy" class="mb-12 scroll-mt-20">
          <div class="max-w-4xl mx-auto p-8 rounded-lg shadow-md bg-dark-card border border-dark-border">
            <h2 class="text-3xl font-bold mb-4">Cookie Policy</h2>
            <p class="text-sm opacity-75 mb-6">Last updated: January 24, 2026</p>

            <div class="space-y-4">
              <p>Zentalist uses cookies and similar technologies to ensure the service functions properly and to improve your experience.</p>

              <h3 class="text-lg font-semibold mt-6">Essential Cookies (Always Active)</h3>
              <p class="text-gray-400 text-sm mb-2">Required for the website to function. Cannot be disabled.</p>
              <ul class="list-disc pl-8">
                <li class="mb-2"><strong>Firebase Authentication</strong> - Keeps you logged in</li>
                <li class="mb-2"><strong>Session storage</strong> - Maintains your app session and preferences</li>
                <li><strong>Local storage</strong> - Stores consent preferences and selected app settings</li>
              </ul>

              <h3 class="text-lg font-semibold mt-6">Analytics Cookies (Optional)</h3>
              <p class="text-gray-400 text-sm mb-2">Help us understand how visitors use the site.</p>
              <ul class="list-disc pl-8">
                <li class="mb-2"><strong>Google Analytics</strong> - Anonymous usage statistics</li>
                <li><strong>Google Tag Manager</strong> - Manages analytics scripts</li>
              </ul>

              <div class="bg-dark-bg border border-dark-border rounded-lg p-4 mt-6">
                <p class="text-sm">
                  <strong>Managing preferences:</strong> On web, you can control cookies through browser settings. In the mobile app (WebView), essential storage may be used for login/session and consent preferences.
                  Disabling essential storage may prevent the service from functioning properly.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Terms of Service Section -->
        <section id="terms-of-service" class="scroll-mt-20">
          <div class="max-w-4xl mx-auto p-8 rounded-lg shadow-md bg-dark-card border border-dark-border">
            <h2 class="text-3xl font-bold mb-4">Terms of Service</h2>
            <p class="text-sm opacity-75 mb-6">Last updated: January 24, 2026</p>

            <div class="space-y-6">
              <div>
                <h3 class="text-xl font-semibold mb-3">1. Service Provider</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2"><strong>Provider:</strong> Adam Krukowski</li>
                  <li class="mb-2"><strong>Contact:</strong> <a href="mailto:contact@zentalist.com"
                      class="text-level-expert hover:underline">contact@zentalist.com</a></li>
                  <li><strong>Payments:</strong> Processed by platform-specific providers: Stripe for web checkout; Apple App Store / Google Play for in-app purchases (through RevenueCat infrastructure).</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">2. Service Description</h3>
                <p class="pl-4 mb-3">Zentalist is a language learning platform offering:</p>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2">Vocabulary flashcards in 8 languages</li>
                  <li class="mb-2">Progress tracking and statistics</li>
                  <li class="mb-2">Challenge mode with quizzes</li>
                  <li>Global leaderboard</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">3. Subscription Plans</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2"><strong>Free:</strong> Access to 1 category per language, limited features</li>
                  <li class="mb-2"><strong>Monthly ($9.99/month):</strong> Full access, cancel anytime</li>
                  <li class="mb-2"><strong>Yearly ($59/year):</strong> Full access, billed annually</li>
                  <li><strong>Lifetime ($99 one-time):</strong> Permanent full access</li>
                </ul>
                <p class="pl-4 mt-3 text-sm text-gray-400">All prices include applicable taxes. Subscriptions auto-renew
                  unless cancelled.</p>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">4. Billing Channels (Web vs Mobile)</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2"><strong>Web:</strong> Purchases and subscription billing are handled by Stripe.</li>
                  <li class="mb-2"><strong>iOS/Android app:</strong> In-app purchases are billed by Apple App Store or Google Play. RevenueCat is used to validate purchases and sync premium access across devices.</li>
                  <li><strong>Important:</strong> Store-specific billing rules may differ from web billing rules and will apply based on where the purchase was made.</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">5. Cancellation & Refunds</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2"><strong>Web subscriptions (Stripe):</strong> Cancel using your web account billing settings. Access continues until the end of the active billing period unless stated otherwise at checkout.</li>
                  <li class="mb-2"><strong>Mobile subscriptions (Apple/Google):</strong> Cancel through your App Store or Google Play subscription settings. Store rules determine billing cycles, renewal cutoffs, and account-level subscription controls.</li>
                  <li class="mb-2"><strong>Refunds for mobile purchases:</strong> Handled by Apple or Google under their store refund policies.</li>
                  <li><strong>Refunds for web purchases:</strong> Handled by us under applicable law and checkout terms. Contact us within 14 days for support requests.</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">6. User Obligations</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2">Provide accurate account information</li>
                  <li class="mb-2">Do not share your account credentials</li>
                  <li class="mb-2">Do not redistribute, copy, or resell any content</li>
                  <li>Use the service respectfully (no offensive display names, etc.)</li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">7. Intellectual Property</h3>
                <p class="pl-4">All content, including flashcards, translations, audio files, and design elements, is
                  protected by copyright. Redistribution without written consent is prohibited.</p>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">8. Complaints</h3>
                <ul class="list-disc pl-8 list-outside">
                  <li class="mb-2">Submit complaints via email to <a href="mailto:contact@zentalist.com"
                      class="text-level-expert hover:underline">contact@zentalist.com</a></li>
                  <li class="mb-2">We will respond within 14 business days</li>
                  <li>EU consumers may use the <a href="https://ec.europa.eu/consumers/odr" target="_blank"
                      class="text-level-expert hover:underline">EU Online Dispute Resolution platform</a></li>
                </ul>
              </div>

              <div class="divider"></div>

              <div>
                <h3 class="text-xl font-semibold mb-3">9. Governing Law</h3>
                <p class="pl-4">These terms are governed by the laws of the Republic of Poland. Consumer protection laws
                  of your country of residence may also apply.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Contact Section -->
        <section id="contact" class="mt-12 mb-12 scroll-mt-20">
          <div class="max-w-4xl mx-auto p-8 rounded-lg shadow-md bg-dark-card border border-dark-border">
            <h2 class="text-3xl font-bold mb-4">Contact</h2>
            <p class="text-gray-300 mb-4">Have questions or need help? Get in touch with us.</p>
            <p class="text-lg">
              <a href="mailto:contact@zentalist.com" class="text-level-expert hover:underline">contact@zentalist.com</a>
              <span class="text-gray-400 text-sm ml-2">(click to email)</span>
            </p>
            <p class="text-gray-400 text-sm mt-4">We typically respond within 24-48 hours.</p>
          </div>
        </section>
      </main>

        <!-- Modale -->
        <%- include('partials/modals') %>

          <!-- Obsługa dropdown menu -->
          <script>
            document.addEventListener("DOMContentLoaded", () => {
              document.addEventListener("click", (e) => {
                const dropdowns = document.querySelectorAll("details.dropdown");

                dropdowns.forEach((dropdown) => {
                  const isClickInside = dropdown.contains(e.target);

                  if (!isClickInside && dropdown.hasAttribute("open")) {
                    dropdown.removeAttribute("open");
                  }
                });
              });
            });
          </script>
          <script defer type="module" src="/scripts/auth.js"></script>
          <script defer type="module" src="/scripts/index.js"></script>
  </body>

</html>