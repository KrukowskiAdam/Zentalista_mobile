 </div><!-- End challenge-content -->
 </div><!-- End challenge-page max-w-4xl container -->

 <!-- How It Works Section (full width) -->
 <div id="how-it-works-section" class="hidden w-full px-4 pb-8">
 <div class="w-full mt-8 bg-learning-app-design-1 shadow-card rounded-xl p-6">
 <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
 <img src="/img/svg/01/bulb-on-svgrepo-com.svg" alt="Bulb" class="w-6 h-6">
 How Challenge Points Work
 </h2>
 <div class="space-y-3 text-sm">
 <div class="flex items-start sm:items-center gap-3">
 <div class="px-3 py-1.5 text-sm font-bold bg-level-mastered rounded min-w-[60px] text-center">
 50</div>
 <div>
 <span class="font-semibold">Perfect first try (100%):</span>
 <span class="font-bold"> +50 points</span>
 </div>
 </div>
 <div class="flex items-start sm:items-center gap-3">
 <div class="px-3 py-1.5 text-sm font-bold bg-level-learning rounded min-w-[60px] text-center">20
 </div>
 <div>
 <span class="font-semibold">Pass first try (90%-99%):</span>
 <span class=""> +20 points</span>
 </div>
 </div>
 <div class="flex items-start sm:items-center gap-3">
 <div class="px-3 py-1.5 text-sm font-bold bg-level-expert rounded min-w-[60px] text-center">TIP
 </div>
 <div>
 <span class="">Points are awarded only once per category. Replays are just for
 practice.</span>
 </div>
 </div>
 </div>
 </div>
 </div>

 <!-- Modale -->
 <%- include('partials/modals') %>

 <script defer type="module" src="/scripts/main.js"></script>
 <script type="module">
 import { initChallengePageNew } from '/scripts/pages/challengePage.js';

 document.addEventListener('DOMContentLoaded', () => {
 if (window.initApp) {
 window.initApp();
 }

 // Show/hide challenge based on login status
 function updateChallengeVisibility(forceShow = false) {
 const authLoading = document.getElementById('auth-loading');
 const loginScreen = document.getElementById('login-required-screen');
 const challengeContent = document.getElementById('challenge-content');
 const howItWorksSection = document.getElementById('how-it-works-section');
 if (!loginScreen || !challengeContent) return;

 const isLoggedIn = window.auth?.currentUser || window.currentUser;

 if (isLoggedIn) {
 if (authLoading) authLoading.classList.add('hidden');
 loginScreen.classList.add('hidden');
 challengeContent.classList.remove('hidden');
 if (howItWorksSection) howItWorksSection.classList.remove('hidden');
 } else if (forceShow) {
 // Only show login screen after we're sure auth has loaded
 if (authLoading) authLoading.classList.add('hidden');
 loginScreen.classList.remove('hidden');
 challengeContent.classList.add('hidden');
 if (howItWorksSection) howItWorksSection.classList.add('hidden');
 }
 }

 // Listen for auth state changes - this is the reliable way
 window.addEventListener('authStateChanged', (event) => {
 updateChallengeVisibility(true);
 if (event.detail?.user) {
 setTimeout(() => initChallengePageNew(), 300);
 }
 });

 // Fallback: if auth doesn't fire event within 2s, show appropriate screen
 setTimeout(() => {
 updateChallengeVisibility(true);
 }, 2000);

 // Also try onAuthStateChanged directly
 if (window.auth) {
 import('https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js').then(({ onAuthStateChanged }) => {
 onAuthStateChanged(window.auth, (user) => {
 updateChallengeVisibility(true);
 if (user) {
 setTimeout(() => initChallengePageNew(), 300);
 }
 });
 }).catch(() => { });
 }

 initChallengePageNew();
 });
 </script>
 </body>

</html>