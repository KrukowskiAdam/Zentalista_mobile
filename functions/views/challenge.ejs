 </div>

 <!-- Results View (hidden initially) -->
 <div id="challenge-results-view" class="hidden">
 <div class="bg-learning-app-design-1 shadow-card rounded-xl p-8 text-center">
 <div id="results-icon" class="mb-4">
 <!-- Icon will be inserted by JS -->
 </div>
 <h2 id="results-title" class="text-2xl font-bold mb-2"></h2>
 <p id="results-score" class="text-lg mb-6"></p>
 <div id="results-message" class="mb-6"></div>
 <div class="flex flex-col sm:flex-row gap-3 justify-center">
 <a href="/stats"
