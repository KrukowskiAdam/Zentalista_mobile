 <!-- Category Selection View -->
 <div id="category-selection-view" class="space-y-4">
 <!-- Outer wrapper with (like leaderboard/stats) -->
 <div class="bg-learning-app-design-3 shadow-card rounded-xl overflow-hidden">
 <!-- Header Row (Flowbite-style) -->
 <div class="p-4 bg-learning-app-design-1">
 <h2 class="text-2xl font-bold">Available Challenges</h2>
 </div>

 <!-- Content Area -->
 <div class="p-4 sm:p-6">

 <!-- Categories will be loaded here by JS -->
 <div id="categories-list" class="space-y-3">
 <div class="text-center py-8">
