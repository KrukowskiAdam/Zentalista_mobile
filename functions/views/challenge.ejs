<!DOCTYPE html>
<html lang="en" class="bg-learning-app-design-2">
<%- include('partials/head') %>

 <body class="m-0 p-0 bg-learning-app-design-2" style="padding-top: calc(80px + constant(safe-area-inset-top)); padding-top: calc(80px + env(safe-area-inset-top, 0px));">
 <!-- Google Tag Manager (noscript) -->
 <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5L47BNJP" height="0" width="0"
 style="display: none; visibility: hidden"></iframe></noscript>
 <!-- End Google Tag Manager (noscript) -->

 <!-- Nawigacja główna -->
 <%- include('partials/menu') %>

 <div id="challenge-page" class="container mx-auto px-4 pt-4 max-w-4xl safe-bottom">
 <!-- Loading spinner while checking auth -->
 <div id="auth-loading" class="text-center py-16 space-y-4">
 <span class="loading loading-spinner loading-lg"></span>
 <p class="text-sm">Checking your account and challenge progress...</p>
 </div>

 <!-- Login required screen for non-logged-in users -->
 <div id="login-required-screen" class="hidden">
 <div class="text-center py-16">
 <div class="mb-6">
 <svg class="w-20 h-20 mx-auto" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
 stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
 </svg>
 </div>
 <h2 class="text-2xl font-bold mb-3">Sign in to take challenges</h2>
 <p class="mb-6 max-w-md mx-auto">
 Complete challenges to lock your categories, earn bonus points, and compete on the global leaderboard.
 </p>
 <label for="modal-login"
 class="btn touch-target bg-level-learning hover:bg-level-learning px-8 w-full sm:w-auto cursor-pointer">
 Sign In
 </label>
 <p class="text-sm mt-4">
 Don't have an account?
 <label for="modal-signup" class="cursor-pointer">Create one for
 free</label>
 </p>
 </div>
 </div>

 <!-- Challenge content (shown only when logged in) -->
 <div id="challenge-content" class="hidden space-y-4">
 <!-- Header card -->
 <div class="rounded-xl bg-learning-app-design-1 p-4 shadow-card">
 <p class="text-xl font-semibold mb-1">Category Challenge</p>
 <p class="text-sm opacity-70">Test your knowledge and lock categories to earn bonus points!</p>
 </div>

 <!-- Category Selection View -->
 <div id="category-selection-view" class="space-y-4">
 <!-- Outer wrapper with (like leaderboard/stats) -->
 <div class="bg-learning-app-design-1 shadow-card rounded-xl overflow-hidden">
 <!-- Header Row (Flowbite-style) -->
 <div class="px-4 pt-4 pb-3 border-b border-learning-app-design-3">
 <p class="text-xl font-semibold">Available Challenges</p>
 </div>

 <!-- Content Area -->
 <div class="p-4">

 <!-- Categories will be loaded here by JS -->
 <div id="categories-list" class="space-y-3">
 <div class="text-center py-8">
 Loading categories...
 </div>
 </div>
 </div>
 </div>
 </div>

 <!-- Challenge Quiz View (hidden initially) -->
 <div id="challenge-quiz-view" class="hidden space-y-4">
 <!-- Progress Header -->
 <div class="bg-learning-app-design-1 shadow-card rounded-xl p-4">
 <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
 <h2 id="quiz-category-name" class="text-xl font-semibold"></h2>
 <span id="quiz-progress" class="text-sm font-medium">0/0</span>
 </div>
 <div class="w-full bg-learning-app-design-3 rounded-full h-2">
 <div id="quiz-progress-bar" class="bg-level-learning h-2 rounded-full transition-all duration-300"
 style="width: 0%"></div>
 </div>
 </div>

 <!-- Question Card -->
 <div class="bg-learning-app-design-1 shadow-card rounded-xl p-4">
 <div class="text-center mb-6 sm:mb-8">
 <p class="text-sm mb-2">Translate this word:</p>
 <div class="flex items-center justify-center gap-4 flex-wrap">
 <h3 id="quiz-question" class="text-3xl sm:text-4xl font-bold"></h3>
 <button id="quiz-audio-btn" type="button"
 class="hidden inline-flex items-center justify-center w-12 h-12 rounded-full bg-learning-app-design-3 hover:bg-learning-app-design-1 transition"
 aria-label="Play pronunciation">
 <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
 stroke="currentColor" stroke-width="1.5">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.868v4.264a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M19.428 15.341A8 8 0 0019.428 8.66M4.5 9.75v4.5a1 1 0 001 1h1.379a1 1 0 01.832.445l1.516 2.273a1 1 0 001.773-.64V6.672a1 1 0 00-1.773-.64L7.711 8.305a1 1 0 01-.832.445H5.5a1 1 0 00-1 1z" />
 </svg>
 </button>
 </div>
 <p id="quiz-question-romanization" class="text-xl mt-2 hidden"></p>
 </div>

 <!-- Answer Buttons -->
 <div id="quiz-answers" class="grid grid-cols-1 gap-2 sm:gap-3">
 <!-- Buttons will be generated by JS -->
 </div>
 </div>

 <!-- Exit Button -->
 <div class="text-center">
 <button id="exit-quiz-btn"
 class="touch-target px-3 py-1.5 text-sm hover:bg-learning-app-design-1 rounded-lg transition-colors">
 Exit Challenge
 </button>
 </div>
 </div>

 <!-- Results View (hidden initially) -->
 <div id="challenge-results-view" class="hidden">
 <div class="bg-learning-app-design-1 shadow-card rounded-xl p-4 text-center">
 <div id="results-icon" class="mb-4">
 <!-- Icon will be inserted by JS -->
 </div>
 <h2 id="results-title" class="text-2xl font-bold mb-2"></h2>
 <p id="results-score" class="text-lg mb-6"></p>
 <div id="results-message" class="mb-6"></div>
 <div class="flex flex-col sm:flex-row gap-3 justify-center">
 <a href="/stats"
 class="touch-target px-4 py-2 bg-level-expert hover:bg-level-expert/80 rounded-lg transition-colors inline-block">View
 Stats</a>
 <a href="/challenge"
 class="touch-target px-4 py-2 hover:bg-learning-app-design-1 rounded-lg transition-colors inline-block">Back
 to Challenges</a>
 </div>
 </div>
 </div>
 </div><!-- End challenge-content -->

 <!-- How It Works Section -->
 <div id="how-it-works-section" class="hidden mt-4">
 <div class="bg-learning-app-design-1 shadow-card rounded-xl p-4">
 <h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
 <img src="/img/svg/01/bulb-on-svgrepo-com.svg" alt="Bulb" class="w-6 h-6">
 How Challenge Points Work
 </h2>
 <div class="space-y-3 text-sm">
 <div class="flex items-start sm:items-center gap-3">
 <div class="px-3 py-1.5 text-sm font-bold bg-level-mastered rounded min-w-[60px] text-center">
 50</div>
 <div>
 <span class="font-semibold">Perfect first try (100%):</span>
 <span class="font-bold"> +50 points</span>
 </div>
 </div>
 <div class="flex items-start sm:items-center gap-3">
 <div class="px-3 py-1.5 text-sm font-bold bg-level-learning rounded min-w-[60px] text-center">20
 </div>
 <div>
 <span class="font-semibold">Pass first try (90%-99%):</span>
 <span class=""> +20 points</span>
 </div>
 </div>
 <div class="flex items-start sm:items-center gap-3">
 <div class="px-3 py-1.5 text-sm font-bold bg-level-expert rounded min-w-[60px] text-center">TIP
 </div>
 <div>
 <span class="">Points are awarded only once per category. Replays are just for
 practice.</span>
 </div>
 </div>
 </div>
 </div>
 </div><!-- End how-it-works-section -->
 </div><!-- End challenge-page max-w-4xl container -->

 <!-- Modale -->
 <%- include('partials/modals') %>

 <script defer type="module" src="/scripts/main.js"></script>
 <script type="module">
 import { initChallengePageNew } from '/scripts/pages/challengePage.js';

 document.addEventListener('DOMContentLoaded', () => {
 const authLoading = document.getElementById('auth-loading');
 const loginScreen = document.getElementById('login-required-screen');
 const challengeContent = document.getElementById('challenge-content');
 const howItWorksSection = document.getElementById('how-it-works-section');
 let initialized = false;

 function onAuthReady(user) {
 if (user) {
 authLoading?.classList.add('hidden');
 loginScreen?.classList.add('hidden');
 challengeContent?.classList.remove('hidden');
 howItWorksSection?.classList.remove('hidden');
 if (!initialized) {
 initialized = true;
 initChallengePageNew();
 }
 } else {
 authLoading?.classList.add('hidden');
 loginScreen?.classList.remove('hidden');
 challengeContent?.classList.add('hidden');
 howItWorksSection?.classList.add('hidden');
 }
 }

 // Primary: custom event fired by auth.js
 window.addEventListener('authStateChanged', (e) => onAuthReady(e.detail?.user));

 // Fallback: direct Firebase listener when window.auth is available
 if (window.auth) {
 import('https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js')
 .then(({ onAuthStateChanged }) => onAuthStateChanged(window.auth, onAuthReady))
 .catch(() => {});
 }
 });
 </script>
 </body>

</html>