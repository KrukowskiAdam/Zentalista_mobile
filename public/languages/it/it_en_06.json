                },
                {
                    "en": "I'm single.",
                    "it": "Sono single.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0032.mp3"
                },
                {
                    "en": "This is my family.",
                    "it": "Questa è la mia famiglia.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0033.mp3"
                },
                {
                    "en": "My father works.",
                    "it": "Mio padre lavora.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0034.mp3"
                },
                {
                    "en": "My mother is at home.",
                    "it": "Mia madre è a casa.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0035.mp3"
                },
                {
                    "en": "How old are they?",
                    "it": "Quanti anni hanno?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0036.mp3"
                },
                {
                    "en": "They live far away.",
                    "it": "Vivono lontano.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0037.mp3"
                },
                {
                    "en": "I miss my family.",
                    "it": "Mi manca la mia famiglia.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0038.mp3"
                },
                {
                    "en": "Family is important.",
                    "it": "La famiglia è importante.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0039.mp3"
                },
                {
                    "en": "I love my family.",
                    "it": "Amo la mia famiglia.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0040.mp3"
                },
                {
                    "en": "Let's visit family.",
                    "it": "Andiamo a trovare la famiglia.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0041.mp3"
                },
                {
                    "en": "Family dinner tonight.",
                    "it": "Cena in famiglia stasera.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0042.mp3"
                },
                {
                    "en": "We live with my parents for now.",
                    "it": "Per ora viviamo con i miei genitori.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0043.mp3"
                },
                {
                    "en": "I'm the oldest child in the family.",
                    "it": "Sono il figlio maggiore della famiglia.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0044.mp3"
                },
                {
                    "en": "We take turns helping with childcare.",
                    "it": "Ci alterniamo per aiutare con la cura dei bambini.",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/it/06/it_0045.mp3"
                },
                {
                    "en": "Could you call my sister and invite her?",
                    "it": "Potresti chiamare mia sorella e invitarla?",
