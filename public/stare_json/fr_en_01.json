                },
                {
                    "en": "What does this mean?",
                    "fr": "Qu'est-ce que ça veut dire ?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0035.mp3"
                },
                {
                    "en": "How do you say...?",
                    "fr": "Comment dit-on... ?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0036.mp3"
                },
                {
                    "en": "Have a good day?",
                    "fr": "Passez une bonne journée",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0037.mp3"
                },
                {
                    "en": "See you tomorrow",
                    "fr": "À demain",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0038.mp3"
                },
                {
                    "en": "It's nice seeing you again",
                    "fr": "C'est agréable de vous revoir",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0039.mp3"
                },
                {
                    "en": "Let's stay in touch",
                    "fr": "Restons en contact",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0040.mp3"
                },
                {
                    "en": "How have you been lately?",
                    "fr": "Comment allez-vous ces derniers temps ?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0041.mp3"
                },
                {
                    "en": "It's been a while since we talked",
                    "fr": "Ça fait longtemps qu'on ne s'est pas parlé",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0042.mp3"
                },
                {
                    "en": "Thanks for following up with me",
                    "fr": "Merci de m'avoir recontacté",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0043.mp3"
                },
                {
                    "en": "Could you introduce yourself?",
                    "fr": "Pourriez-vous vous présenter ?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0044.mp3"
                },
                {
                    "en": "Let me introduce myself properly",
                    "fr": "Permettez-moi de me présenter correctement",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/fr/01/fr_0045.mp3"
                }
            ]
