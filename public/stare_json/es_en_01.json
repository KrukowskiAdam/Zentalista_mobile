        {
            "name": "Greetings & Polite Expressions - Phrases",
            "words": [
                {
                    "en": "How are you?",
                    "es": "¿Cómo estás?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0021.mp3"
                },
                {
                    "en": "I'm fine",
                    "es": "Estoy bien",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0022.mp3"
                },
                {
                    "en": "What's your name?",
                    "es": "¿Cómo te llamas?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0023.mp3"
                },
                {
                    "en": "My name is..",
                    "es": "Me llamo..",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0024.mp3"
                },
                {
                    "en": "It's great finally meeting you in person",
                    "es": "Es genial conocerte finalmente en persona",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0025.mp3"
                },
                {
                    "en": "Where are you from?",
                    "es": "¿De dónde eres?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0026.mp3"
                },
                {
                    "en": "I'm from..",
                    "es": "Soy de..",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0027.mp3"
                },
                {
                    "en": "How old are you?",
                    "es": "¿Cuántos años tienes?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0028.mp3"
                },
                {
                    "en": "I'm... years old",
                    "es": "Tengo... años",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0029.mp3"
                },
                {
                    "en": "Do you speak English?",
                    "es": "¿Hablas inglés?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0030.mp3"
                },
                {
                    "en": "I speak a little",
                    "es": "Hablo un poco",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0031.mp3"
                },
                {
                    "en": "I don't understand",
                    "es": "No entiendo",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0032.mp3"
                },
                {
                    "en": "Can you repeat?",
                    "es": "¿Puedes repetir?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0033.mp3"
                },
                {
                    "en": "Please speak slowly",
                    "es": "Por favor, habla despacio",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0034.mp3"
                },
                {
                    "en": "What does this mean?",
                    "es": "¿Qué significa esto?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0035.mp3"
                },
                {
                    "en": "How do you say...?",
                    "es": "¿Cómo se dice...?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0036.mp3"
                },
                {
                    "en": "Have a good day?",
                    "es": "Que tengas un buen día",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0037.mp3"
                },
                {
                    "en": "See you tomorrow",
                    "es": "Hasta mañana",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0038.mp3"
                },
                {
                    "en": "It's nice seeing you again",
                    "es": "Es bueno verte de nuevo",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0039.mp3"
                },
                {
                    "en": "Let's stay in touch",
                    "es": "Mantengamos el contacto",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0040.mp3"
                },
                {
                    "en": "How have you been lately?",
                    "es": "¿Cómo has estado últimamente?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0041.mp3"
                },
                {
                    "en": "It's been a while since we talked",
                    "es": "Ha pasado un tiempo desde que hablamos",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0042.mp3"
                },
                {
                    "en": "Thanks for following up with me",
                    "es": "Gracias por contactarme",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0043.mp3"
                },
                {
                    "en": "Could you introduce yourself?",
                    "es": "¿Podrías presentarte?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0044.mp3"
                },
                {
                    "en": "Let me introduce myself properly",
                    "es": "Permíteme presentarme adecuadamente",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0045.mp3"
                }
            ]
        },
