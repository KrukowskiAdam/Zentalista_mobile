                },
                {
                    "en": "I'll send you the invitation",
                    "es": "Te enviaré la invitación",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0151.mp3"
                },
                {
                    "en": "Can we schedule a call?",
                    "es": "¿Podemos programar una llamada?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/es/01/es_0152.mp3"
                },
                {
                    "en": "Here is a quick update",
