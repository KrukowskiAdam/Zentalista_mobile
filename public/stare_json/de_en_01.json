                },
                {
                    "en": "Please speak slowly",
                    "de": "Bitte sprechen Sie langsam",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0034.mp3"
                },
                {
                    "en": "What does this mean?",
                    "de": "Was bedeutet das?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0035.mp3"
                },
                {
                    "en": "How do you say...?",
                    "de": "Wie sagt man...?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0036.mp3"
                },
                {
                    "en": "Have a good day?",
                    "de": "Haben Sie einen schönen Tag?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0037.mp3"
                },
                {
                    "en": "See you tomorrow",
                    "de": "Bis morgen",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0038.mp3"
                },
                {
                    "en": "It's nice seeing you again",
                    "de": "Es ist schön, Sie wiederzusehen",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0039.mp3"
                },
                {
                    "en": "Let's stay in touch",
                    "de": "Lassen Sie uns in Kontakt bleiben",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0040.mp3"
                },
                {
                    "en": "How have you been lately?",
                    "de": "Wie ist es Ihnen in letzter Zeit ergangen?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0041.mp3"
                },
                {
                    "en": "It's been a while since we talked",
                    "de": "Es ist eine Weile her, seit wir gesprochen haben",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0042.mp3"
                },
                {
                    "en": "Thanks for following up with me",
                    "de": "Danke, dass Sie sich bei mir gemeldet haben",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0043.mp3"
                },
                {
                    "en": "Could you introduce yourself?",
                    "de": "Könnten Sie sich vorstellen?",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0044.mp3"
                },
                {
                    "en": "Let me introduce myself properly",
                    "de": "Lassen Sie mich mich richtig vorstellen",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0045.mp3"
                }
            ]
