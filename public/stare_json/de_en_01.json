                },
                {
                    "en": "I speak a little",
                    "de": "Ich spreche ein wenig",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0031.mp3"
                },
                {
                    "en": "I don't understand",
                    "de": "Ich verstehe nicht",
                    "audio": "https://storage.googleapis.com/costam-3f612.firebasestorage.app/audio/de/01/de_0032.mp3"
                },
                {
                    "en": "Can you repeat?",
                    "de": "Können Sie das wiederholen?",
